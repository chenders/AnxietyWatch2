#include "Shared.xcconfig"
IPHONEOS_DEPLOYMENT_TARGET = 18.0
TARGETED_DEVICE_FAMILY = 1
PRODUCT_BUNDLE_IDENTIFIER = com.groundeffectsoftware.AnxietyWatch
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_CFBundleDisplayName = Anxiety Watch
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_NSAppTransportSecurity_NSAllowsLocalNetworking = YES
INFOPLIST_KEY_NSHealthShareUsageDescription = AnxietyWatch reads selected Health data to securely upload source records to your Pi.
INFOPLIST_KEY_BGTaskSchedulerPermittedIdentifiers = com.groundeffectsoftware.AnxietyWatch.healthkit-drain
INFOPLIST_KEY_UIBackgroundModes = fetch
INFOPLIST_KEY_UILaunchScreen_Generation = YES
CODE_SIGN_ENTITLEMENTS = AnxietyWatchApp/AnxietyWatchApp.entitlements

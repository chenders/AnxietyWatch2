tmp/

# Agent harness worktrees: full nested checkouts, hundreds of MB. The agents and
# commands definitions directly under .claude/ ARE tracked, so ignore only this.
.claude/worktrees/

# Agent session memory (the remember plugin): per-session logs of what was done
# on this machine and the Pi. It was kept out only by a `*` .gitignore the plugin
# writes inside its own directory -- one plugin change or fresh clone away from
# `git add -A` sweeping it in. scripts/check-tracked-paths.py also rejects it.
.remember/

build/
build-*/
cmake-build-*/
.cache/
compile_commands.json
*.o
*.a
*.so
crash-*
leak-*
timeout-*
corpus/
.env
*.local
.DS_Store
.idea/
.idea/workspace.xml
.idea/tasks.xml
.idea/usage.statistics.xml
.idea/shelf/
.idea/httpRequests/
target/

# cargo-fuzz
fuzz/target/
fuzz/artifacts/
fuzz/coverage/

__pycache__/
*.pyc

# PHI: raw capture output. bp_capture.py fsyncs real measurements here by
# design, btmon writes .snoop, T-B1 writes night*.log. None belongs in git.
*.snoop
*-capture.jsonl
bp-capture.jsonl
bpcap*.log
night*.log

# The personal denylist the pre-push PHI gate reads. Never committed — the
# repo must not contain the strings the guard exists to keep out.
.githooks/pii-denylist.local.txt

# python tooling
.venv/
uv.lock
.pytest_cache/

# SwiftPM build products are local and contain absolute developer paths.
clients/apple/Packages/*/.build/

# Runtime data for the pi-panel live stopgap. Written on the Pi; local copies
# are only ever test fixtures and must not dirty the deploy-key checkout.
docs/design/pi-panel/direction-a-clinical/status.json
docs/design/pi-panel/direction-a-clinical/vitals_status.json
docs/design/pi-panel/direction-a-clinical/vitals_h10_history.json

# Competitive-research working package. It holds third-party quotation, vendor
# screenshots-free extracts and unpublished analysis; it is deliberately never
# committed and never pushed. It lives on disk with its own local-only git
# repository (work tree here, history in $HOME/aw2research/app-comparison.git),
# which has no remote and no relationship to this one.
# See docs/app_comparison/LOCAL-ONLY.md.
docs/app_comparison/

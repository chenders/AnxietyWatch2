/*
 * nRF52840 Dongle (PCA10059) device tree overlay.
 *
 * Routes zephyr,console to the USB CDC ACM virtual UART so the serial
 * console appears as /dev/ttyACM0 (Linux) or /dev/cu.usbmodem* (macOS)
 * when the dongle is plugged into USB.
 *
 * The green LED (led0 on P0.6) indicates BLE connection state.
 * The RGB LED (led1 — P0.8/P1.9/P0.12) indicates measurement activity.
 */

/ {
    chosen {
        zephyr,console = &cdc_acm_uart0;
        zephyr,shell-uart = &cdc_acm_uart0;
    };

    leds {
        compatible = "gpio-leds";
        led0: led_0 {
            gpios = <&gpio0 6 GPIO_ACTIVE_HIGH>;
            label = "Green LED (connection)";
        };
    };
};

&zephyr_udc0 {
    cdc_acm_uart0: cdc_acm_uart0 {
        compatible = "zephyr,cdc-acm-uart";
    };
};

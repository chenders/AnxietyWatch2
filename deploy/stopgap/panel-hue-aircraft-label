#!/usr/bin/env python3
"""Turn the bedroom-door Hue button into aircraft-noise ground truth.

One press records that the resident heard/noticed an aircraft. Two presses in
one gesture record that the cat heard it and was frightened. The second label
is deliberately retained as a stronger, separate outcome rather than being
collapsed into "heard".
"""

import json
import os
import ssl
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.request
from pathlib import Path

BRIDGE = os.environ.get("HUE_BRIDGE")
USERNAME = os.environ.get("HUE_USERNAME")
BUTTON_ID = os.environ.get("HUE_AIRCRAFT_BUTTON_ID")
STATUS = Path(os.environ.get("ADSB_STATUS_JSON", "/opt/anxietywatch-panel/docs/design/pi-panel/direction-a-clinical/adsb_status.json"))
PASS_LOG = Path(os.environ.get("PANEL_NOISE_LOG", "/var/lib/panel-noise/loud-aircraft.jsonl"))
LABELS = Path(os.environ.get("PANEL_AIRCRAFT_LABELS", "/var/lib/panel-noise/aircraft-labels.jsonl"))
STATE = Path(os.environ.get("PANEL_AIRCRAFT_BUTTON_STATE", "/var/lib/panel-noise/hue-button-state.json"))
DOUBLE_SECONDS = float(os.environ.get("HUE_BUTTON_DOUBLE_SECONDS", "1.35"))
CONTEXT_BEFORE_SECONDS = 240.0
# The durable row is a point-in-time snapshot. Passes that finish later are
# joined by the offline analyzer from PASS_LOG; admitting future rows here
# would make capture timing nondeterministic.
CONTEXT_AFTER_SECONDS = 0.0


def synthetic_mode(value):
    """Parse provenance configuration closed; a typo must never create real evidence."""
    normalized = value.strip().lower()
    if normalized in ("1", "true", "yes", "on"):
        return True
    if normalized in ("", "0", "false", "no", "off"):
        return False
    raise ValueError(f"synthetic provenance blocked: unrecognized value {value!r}")


SYNTHETIC = synthetic_mode(os.environ.get("PANEL_AIRCRAFT_LABEL_SYNTHETIC", ""))
STATE_LOCK = threading.RLock()


def atomic_json(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    with tmp.open("w") as stream:
        json.dump(value, stream, separators=(",", ":"))
        stream.flush()
        os.fsync(stream.fileno())
    os.replace(tmp, path)


def append_fsync(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    encoded = json.dumps(value, separators=(",", ":"), sort_keys=True) + "\n"
    with path.open("a") as stream:
        stream.write(encoded)
        stream.flush()
        os.fsync(stream.fileno())


def read_json(path):
    try:
        with path.open() as stream:
            return json.load(stream)
    except (OSError, ValueError):
        return None


def merge_state(changes, remove=()):
    """Atomically change status without erasing concurrent health fields."""
    with STATE_LOCK:
        state = read_json(STATE) or {}
        state.update(changes)
        for key in remove:
            state.pop(key, None)
        atomic_json(STATE, state)


def write_health(state, reason=None):
    """Publish a health transition without write-amplifying steady state."""
    with STATE_LOCK:
        current = read_json(STATE) or {}
        if current.get("stream_state") == state and current.get("stream_error") == reason:
            return
        changes = {"stream_state": state, "stream_changed_at": time.time()}
        if reason is not None:
            changes["stream_error"] = reason
        merge_state(changes, () if reason is not None else ("stream_error",))


def recent_passes(at):
    rows = []
    try:
        with PASS_LOG.open() as stream:
            for line in stream:
                try:
                    row = json.loads(line)
                except ValueError:
                    continue
                stamp = row.get("at")
                if isinstance(stamp, (int, float)) and at - CONTEXT_BEFORE_SECONDS <= stamp <= at + CONTEXT_AFTER_SECONDS:
                    rows.append(row)
    except OSError:
        pass
    return rows[-250:]


def current_candidates(snapshot):
    if not isinstance(snapshot, dict):
        return []
    out = []
    seen = set()
    for key in ("adsb_planes", "adsb_predictions", "adsb_heard_unlocated"):
        aircraft_rows = snapshot.get(key)
        if not isinstance(aircraft_rows, list):
            continue
        for aircraft in aircraft_rows:
            if not isinstance(aircraft, dict):
                continue
            ident = aircraft.get("hex") or aircraft.get("registration") or aircraft.get("callsign")
            marker = (key, ident)
            if marker not in seen:
                seen.add(marker)
                out.append({"feed": key, "aircraft": aircraft})
    return out


def record_label(first_press, presses):
    recorded = time.time()
    priority = "cat_scared_top_priority" if presses >= 2 else "human_heard"
    snapshot = read_json(STATUS)
    row = {
        "schema": 1,
        "event_id": f"hue-{int(first_press * 1000)}-{presses}",
        "observed_at": first_press,
        "recorded_at": recorded,
        "press_count": presses,
        "label": priority,
        "priority": 2 if presses >= 2 else 1,
        "provenance": "synthetic" if SYNTHETIC else "hue_button",
        "eligible_for_training": not SYNTHETIC,
        "meaning": ("cat heard the aircraft and was frightened; top-priority false-negative evidence"
                    if presses >= 2 else
                    "resident heard and noticed an aircraft; false-negative/threshold-training evidence"),
        "button": {"resource_id": BUTTON_ID, "double_window_seconds": DOUBLE_SECONDS},
        "clock": {"source": "system UTC epoch", "ntp_required_by_service": True},
        "live_feed_written_at": snapshot.get("written_at") if isinstance(snapshot, dict) else None,
        "live_candidates": current_candidates(snapshot),
        "recent_completed_passes": recent_passes(first_press),
    }
    append_fsync(LABELS, row)
    # The evidence is durable now. Clear recovery state before slow secondary
    # analysis so a crash cannot append this label and mark it heard twice.
    merge_state({}, remove=("pending_gesture",))
    # Feed only real observations into the existing contrast-based correlator.
    # Synthetic events prove the plumbing; treating them as heard aircraft would
    # poison the very threshold model they are intended to test.
    if SYNTHETIC:
        correlator = {"skipped": "synthetic labels are ineligible for training"}
    else:
        note = "Hue button: cat heard and scared (TOP PRIORITY)" if presses >= 2 else "Hue button: human heard aircraft"
        suspected = "CAT_SCARED" if presses >= 2 else "AIRCRAFT_HEARD"
        try:
            result = subprocess.run(["/usr/local/bin/panel-heard", "--ago", str(max(0.0, recorded - first_press)),
                                     "--suspected", suspected, "--note", note],
                                    check=False, capture_output=True, text=True, timeout=15)
            correlator = {"returncode": result.returncode, "stdout": result.stdout[-1000:], "stderr": result.stderr[-1000:]}
        except (OSError, subprocess.SubprocessError) as exc:
            correlator = {"error": str(exc)}
    merge_state({"last_label": priority, "press_count": presses, "observed_at": first_press,
                 "recorded_at": recorded, "correlator": correlator})
    print(f"panel-hue-aircraft-label: recorded {priority} ({presses} press{'es' if presses != 1 else ''}, "
          f"provenance={'synthetic' if SYNTHETIC else 'hue_button'})", flush=True)


def events_from_payload(payload):
    try:
        batches = json.loads(payload)
    except ValueError:
        return []
    found = []
    if not isinstance(batches, list):
        return found
    for batch in batches:
        if not isinstance(batch, dict) or batch.get("type") != "update":
            continue
        data = batch.get("data")
        if not isinstance(data, list):
            continue
        for item in data:
            if not isinstance(item, dict) or item.get("id") != BUTTON_ID or item.get("type") != "button":
                continue
            button = item.get("button")
            if not isinstance(button, dict):
                continue
            report = button.get("button_report")
            if not isinstance(report, dict):
                continue
            if report.get("event") == "initial_press":
                found.append(report.get("updated") or batch.get("creationtime") or str(time.time()))
    return found


def validate_configuration():
    missing = [name for name, value in (("HUE_BRIDGE", BRIDGE), ("HUE_USERNAME", USERNAME),
                                        ("HUE_AIRCRAFT_BUTTON_ID", BUTTON_ID)) if not value]
    if missing:
        raise SystemExit(f"Hue stream blocked: {', '.join(missing)} not configured")


def stream_once(on_press, on_tick):
    headers = {"hue-application-key": USERNAME, "Accept": "text/event-stream"}
    previous = read_json(STATE) or {}
    if previous.get("last_event_id"):
        headers["Last-Event-ID"] = previous["last_event_id"]
    request = urllib.request.Request(f"https://{BRIDGE}/eventstream/clip/v2", headers=headers)
    context = ssl._create_unverified_context()
    with urllib.request.urlopen(request, context=context, timeout=90) as response:
        write_health("connected")
        data = []
        event_id = None
        for raw in response:
            line = raw.decode("utf-8", "replace").rstrip("\r\n")
            if line.startswith("data:"):
                data.append(line[5:].lstrip())
            elif line.startswith("id:"):
                event_id = line[3:].lstrip()
            elif not line:
                if data:
                    payload = "\n".join(data)
                    data = []
                    for token in events_from_payload(payload):
                        on_press(token)
                    if event_id:
                        merge_state({"last_event_id": event_id})
                on_tick()
        raise RuntimeError("Hue event stream ended")


class GestureTracker:
    """Durable, duplicate-resistant one/double-press classifier."""

    def __init__(self, emit=record_label, clock=time.time, scheduler=threading.Timer):
        self.emit = emit
        self.clock = clock
        self.scheduler = scheduler
        self.timer = None
        self.lock = threading.RLock()
        state = read_json(STATE) or {}
        pending = state.get("pending_gesture")
        self.pending_at = pending.get("at") if isinstance(pending, dict) else None
        self.pending_count = pending.get("count", 0) if isinstance(pending, dict) else 0
        self.seen_tokens = []
        if self.pending_at is not None:
            self._schedule()

    def _schedule(self):
        if self.scheduler is None:
            return
        if self.timer is not None:
            self.timer.cancel()
        remaining = max(0.0, DOUBLE_SECONDS - (self.clock() - self.pending_at))
        self.timer = self.scheduler(remaining, self.flush)
        self.timer.daemon = True
        self.timer.start()

    def press(self, token):
        with self.lock:
            if token in self.seen_tokens:
                return
            self.seen_tokens.append(token)
            del self.seen_tokens[:-32]
            now = self.clock()
            if self.pending_at is not None and now - self.pending_at <= DOUBLE_SECONDS:
                self.pending_count += 1
            else:
                self.flush()
                self.pending_at, self.pending_count = now, 1
            merge_state({"pending_gesture": {"at": self.pending_at, "count": self.pending_count}})
            self._schedule()

    def flush(self):
        with self.lock:
            if self.pending_at is not None:
                at, count = self.pending_at, self.pending_count
                self.pending_at, self.pending_count = None, 0
                self.timer = None
                self.emit(at, count)

    def tick(self):
        with self.lock:
            if self.pending_at is not None and self.clock() - self.pending_at >= DOUBLE_SECONDS:
                self.flush()


def main():
    validate_configuration()
    tracker = GestureTracker()
    retry_seconds = 1.0
    while True:
        tracker.tick()
        try:
            stream_once(tracker.press, tracker.tick)
        except (OSError, urllib.error.URLError, TimeoutError, RuntimeError) as exc:
            write_health("disconnected", str(exc))
            print(f"panel-hue-aircraft-label: event stream disconnected: {exc}; "
                  f"retry in {retry_seconds:.0f}s", file=sys.stderr, flush=True)
            tracker.tick()
            time.sleep(retry_seconds)


if __name__ == "__main__":
    raise SystemExit(main())

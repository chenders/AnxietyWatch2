[Unit]
Description=Publish dump1090 aircraft to the bedside panel
After=dump1090-mutability.service panel-http.service
Requires=dump1090-mutability.service
Before=panel-status-merge.service

[Service]
Type=simple
User=anxietywatch
# Set the receiver location without committing a home location:
#   sudo systemctl edit panel-adsb-status
#   [Service]
#   Environment=STATION_LAT=...
#   Environment=STATION_LON=...
Environment=ADSB_STATUS_JSON=/opt/anxietywatch-panel/docs/design/pi-panel/direction-a-clinical/adsb_status.json
# Durable record of what actually flew over: one row per PASS, not per publish.
# Shared with panel-fr24-poll, which writes rows to the same file under a
# different provenance. Receiver rows never expire -- that data came off an
# antenna on this roof, so no vendor licence governs how long it is kept.
Environment=PANEL_NOISE_LOG=/var/lib/panel-noise/loud-aircraft.jsonl
ExecStart=/usr/local/bin/panel-adsb-status
Restart=always
RestartSec=3
# Creates /var/lib/panel-noise with the right ownership, so it needs no
# ReadWritePaths entry despite ProtectSystem=strict.
StateDirectory=panel-noise
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/run/dump1090-mutability
ReadWritePaths=/opt/anxietywatch-panel/docs/design/pi-panel/direction-a-clinical
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target

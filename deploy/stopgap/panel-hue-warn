# The fixed HUE_FLASH_BRIGHTNESS knob (160, then 200) is gone as of
# 2026-08-17: brightness is now RELATIVE to each light's captured state via
# flash_brightness() below. Restoration is unaffected -- the light's own
# state is captured before the flash and put back regardless.

# Hue's brightness scale is 1-254 (0 is not valid; off is a separate state), so
# 90% is 229. Since 2026-08-17 this is only the FALLBACK, used when a light
# reports no brightness of its own (on/off plugs, which cannot dim anyway).
# Every dimmable light gets a RELATIVE brightness from flash_brightness().
ALERT_BRIGHTNESS = max(1, min(254, int(os.environ.get("HUE_ALERT_BRIGHTNESS", "229"))))

# Relative flash brightness, owner decision 2026-08-17: the warning should be
# noticeably brighter than the room IS, not absolutely bright. A dark bedroom
# does not need 90% to notice a light coming on at all; a bright one needs
# more than 90% would add.
#   off (or dimmer than the floor)  -> FLASH_FLOOR_BRI   (~30%)
#   on at brightness B              -> B + FLASH_BOOST_BRI, capped at 254
# At 254 the colour alternation still carries the signal.
FLASH_FLOOR_BRI = max(1, min(254, int(os.environ.get("HUE_FLASH_FLOOR_BRI", "77"))))
FLASH_BOOST_BRI = max(0, min(253, int(os.environ.get("HUE_FLASH_BOOST_BRI", "64"))))


def luminance_factor(xy):
    """Roughly how much LIGHT a colour point emits per bri step, relative to
    the LED mixer's peak. Hue's `bri` is a drive level, not lumens: a deep
    saturated colour uses only part of the mix, so orange at 197 can emit
    less actual light than white at 133 -- which the owner observed on
    2026-08-17 when a "brighter" orange hold read as no change at all.

    xy -> XYZ (Y=1) -> linear sRGB-ish channels, peak-normalised the way an
    LED mixer is, then photometric weighting. An approximation, but the
    error is a few percent where a naive bri comparison was off by 3x.
    """
    x, y = xy
    if y <= 0:
        return 1.0
    big_x, big_z = x / y, (1.0 - x - y) / y
    r = 3.2406 * big_x - 1.5372 - 0.4986 * big_z
    g = -0.9689 * big_x + 1.8758 + 0.0415 * big_z
    b = 0.0557 * big_x - 0.2040 + 1.0570 * big_z
    peak = max(r, g, b)
    if peak <= 0:
        return 1.0
    r, g, b = (max(0.0, c / peak) for c in (r, g, b))
    return max(0.05, 0.2126 * r + 0.7152 * g + 0.0722 * b)


# The reference: what a bri step is worth in WHITE, the unit the floor and
# boost are expressed in.
WHITE_FACTOR = luminance_factor(XY_WHITE)


def state_luminance_factor(captured_state):
    """The efficacy of whatever the light was showing BEFORE the warning.

    Colour-temperature whites all sit near peak efficacy; an xy colour is
    computed properly; hue/sat is approximated by its saturation, which is
    the dimension that costs light.
    """
    if "xy" in captured_state:
        return luminance_factor(captured_state["xy"])
    if "ct" in captured_state:
        return WHITE_FACTOR
    sat = captured_state.get("sat")
    if isinstance(sat, (int, float)):
        return max(0.05, WHITE_FACTOR * (1.0 - 0.7 * min(254, max(0, sat)) / 254.0))
    return WHITE_FACTOR


def flash_brightness(captured_state, target_xy=None):
    """The bri to command for ONE light showing ONE warning colour, so the
    warning is noticeably brighter in PERCEIVED light than the room was.

    Everything is computed in white-equivalent luminance: the room's current
    perceived output (its bri times its colour's efficacy), plus the boost,
    with the floor for a dark room -- then converted back through the WARNING
    colour's own efficacy, because a dim colour needs more drive to deliver
    the same light. Capped at 254: a deep colour at full drive may still be
    dimmer than a bright white room, and then the COLOUR is the signal.

    A light that reports no brightness gets the fixed fallback -- it cannot
    dim, so relativity is meaningless for it.
    """
    bri = captured_state.get("bri")
    if not isinstance(bri, (int, float)):
        return ALERT_BRIGHTNESS
    baseline = bri if captured_state.get("on") else 0
    current_light = baseline * state_luminance_factor(captured_state)
    target_light = max(FLASH_FLOOR_BRI * WHITE_FACTOR,
                       current_light + FLASH_BOOST_BRI * WHITE_FACTOR)
    factor = luminance_factor(target_xy) if target_xy is not None else WHITE_FACTOR
    return int(max(1, min(254, round(target_light / factor))))

TIMEOUT = float(os.environ.get("HUE_TIMEOUT_SECONDS", "4"))


def require(name, value):
    if not value:
        raise SystemExit(
            f"panel-hue-warn: {name} is required; set it in a systemd drop-in "
            f"(systemctl edit panel-hue-warn). The bridge address and username "
            f"are credentials and must never be committed.")
    return value


def call(method, path, body=None):
    """One bridge request. Returns (payload, error) -- never raises.

    The bridge answers 200 with an error object in the body rather than an HTTP
    status, so the payload is inspected for one. Treating HTTP 200 as success
    would report a rejected credential as a successful write.
    """
    url = f"http://{BRIDGE}/api/{USERNAME}{path}"
    data = json.dumps(body).encode() if body is not None else None
    request = urllib.request.Request(url, data=data, method=method,
                                     headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(request, timeout=TIMEOUT) as response:
            payload = json.loads(response.read() or b"null")
    except urllib.error.HTTPError as exc:
        return None, f"bridge returned HTTP {exc.code}"
    except (urllib.error.URLError, TimeoutError, OSError) as exc:
        return None, f"bridge {BRIDGE} unreachable: {exc}"
    except ValueError as exc:
        return None, f"bridge returned unparseable JSON: {exc}"

    if isinstance(payload, list):
        for item in payload:
            if isinstance(item, dict) and "error" in item:
                detail = item["error"]
                return None, (f"bridge rejected the request: "
                              f"{detail.get('description')} ({detail.get('address')})")
    return payload, None


def capture(light_id):
    """The light's current state, or (None, error).

    Captured BEFORE anything is changed. Without this the warning cannot be
    undone, and an unattended light left on overnight is a worse outcome than no
    warning at all.
    """
    payload, error = call("GET", f"/lights/{light_id}")
    if error is not None:
        return None, error
    state = (payload or {}).get("state") or {}
    if "on" not in state:
        return None, f"light {light_id} reported no state"

    # Colour and brightness are captured whether the light is on or OFF.
    #
    # Restoring only {"on": false} looks correct -- the light is off, as it was
    # -- but leaves the bridge holding the FLASH colour as that light's stored
    # state. The next time someone switches the fixture on by hand it comes up
    # cyan at brightness 160 instead of their warm white. The failure is
    # invisible at the time and surfaces hours later, which makes it worse than
    # an obvious one.
    #
    # Verified against the real bridge: a PUT carrying bri/ct alongside
    # "on": false is accepted with no error and does not light the room, so the
    # full state can be put back without a second flash.
    restore = {"on": bool(state["on"])}
    if "bri" in state:
        restore["bri"] = state["bri"]
    # `colormode` decides which of xy/ct/hs is authoritative; restoring the
    # wrong one changes the colour even when every value is faithfully copied.
    mode = state.get("colormode")
    if mode == "xy" and "xy" in state:
        restore["xy"] = state["xy"]
    elif mode == "ct" and "ct" in state:
        restore["ct"] = state["ct"]
    elif mode == "hs":
        if "hue" in state:
            restore["hue"] = state["hue"]
        if "sat" in state:
            restore["sat"] = state["sat"]
    return restore, None


def apply_state(light_id, state):
    return call("PUT", f"/lights/{light_id}/state", state)


# The restore is verified by reading the light back, because a bridge "OK" is
# only an acknowledgement that the COMMAND was accepted -- Zigbee delivery is
# best-effort, and on 2026-08-17 a bedroom bulb dropped its restore write and
# sat purple after the warning ended: the exact outcome this file exists to
# prevent. Writes during the warning self-heal by repetition; the restore is
# the last write, so it must be confirmed instead.
#
# AND the confirmation itself is weak: the bridge's reported state is largely
# its own cache of the last accepted command, not ground truth from the bulb.
# Seen live the same evening: the bridge reported warm-white ct/133 as stable
# for 24+ seconds while the physical bulb sat purple. So a matching read-back
# upgrades confidence but never ends the effort early: the restore state is
# ALWAYS written at least twice, spaced, because on a marginal Zigbee link
# repetition is the only mechanism that demonstrably delivers.
RESTORE_ATTEMPTS = 3
RESTORE_MIN_WRITES = 2
RESTORE_SETTLE_SECONDS = 0.6   # transitiontime 4 == 400 ms, plus margin


def state_matches(expected, actual):
    """Does the light's reported state match what the restore asked for?

    Tolerances absorb the bridge's own rounding, not real differences.
    """
    if bool(actual.get("on")) != bool(expected.get("on")):
        return False
    if "bri" in expected:
        if not isinstance(actual.get("bri"), (int, float)):
            return False
        if abs(actual["bri"] - expected["bri"]) > 3:
            return False
    if "xy" in expected:
        got = actual.get("xy")
        if (not isinstance(got, (list, tuple)) or len(got) != 2
                or any(abs(a - b) > 0.01 for a, b in zip(got, expected["xy"]))):
            return False
    if "ct" in expected:
        if (not isinstance(actual.get("ct"), (int, float))
                or abs(actual["ct"] - expected["ct"]) > 3):
            return False
    if "hue" in expected:
        if (not isinstance(actual.get("hue"), (int, float))
                or abs(actual["hue"] - expected["hue"]) > 200):
            return False
    if "sat" in expected:
        if (not isinstance(actual.get("sat"), (int, float))
                or abs(actual["sat"] - expected["sat"]) > 3):
            return False
    return True


def restore_verified(light_id, expected):
    """Write the restore state, read the light back, retry until it matches.

    Returns None on confirmed success, else a message naming what could not
    be confirmed. An unreadable light is treated as unconfirmed -- unknown is
    not restored.
    """
    last = None
    confirmed = False
    target = dict(expected, alert="none", transitiontime=4)
    for attempt in range(RESTORE_ATTEMPTS):
        _, error = apply_state(light_id, target)
        if error is not None:
            last = error
            continue
        time.sleep(RESTORE_SETTLE_SECONDS)
        payload, error = call("GET", f"/lights/{light_id}")
        if error is not None:
            last = f"unverifiable: {error}"
            continue
        actual = (payload or {}).get("state") or {}
        if state_matches(expected, actual):
            confirmed = True
            # The bridge cache can confirm a command the bulb never heard, so
            # success does not end the effort until the minimum write count is
            # met -- repetition is what actually delivers on a weak link.
            if attempt + 1 >= RESTORE_MIN_WRITES:
                return None
            continue
        confirmed = False
        last = (f"light reports {actual.get('colormode')} bri={actual.get('bri')} "
                f"on={actual.get('on')}, wanted {target}")
    if confirmed:
        return None
    return f"not confirmed after {RESTORE_ATTEMPTS} attempts: {last}"


def publish(document):
    try:
        OUTPUT.parent.mkdir(parents=True, exist_ok=True)
        tmp = OUTPUT.with_name(f".{OUTPUT.name}.tmp")
        with tmp.open("w") as stream:
            json.dump(document, stream, separators=(",", ":"), allow_nan=False)
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(tmp, 0o644)
        os.replace(tmp, OUTPUT)
    except OSError as exc:
        print(f"panel-hue-warn: cannot write {OUTPUT}: {exc}", flush=True)


def warning_record(report, band, left, fired, suppressed_by=None,
                   hold_s=0.0, testing=False, now=None):
    """One warning decision, self-contained enough to review months later."""
    now = time.time() if now is None else now
    prediction = report.get("prediction") or {}
    return {
        "schema": 1,
        "warning_id": f"warn-{int(now * 1000)}-{report.get('hex') or 'unknown'}",
        "at": now,
        "fired": bool(fired),
        # Named, never silent: a warning that did not flash says exactly why.
        "suppressed_by": suppressed_by,
        "test": bool(testing),
        "hex": report.get("hex"),
        "registration": report.get("registration"),
        "callsign": report.get("callsign"),
        "operator_kind": report.get("operator_kind"),
        "band": band,
        "notice_s": round(left, 1) if isinstance(left, (int, float)) else None,
        "late": bool(hold_s),
        "hold_s": round(hold_s, 1) if hold_s else 0.0,
        # Verbatim, so the review page can show what the model believed.
        "prediction": prediction or None,
    }


def log_warning(record):
    """Append one decision durably. Never raises: a full disk must not stop
    the next warning, but it must be said out loud."""
    try:
        WARNING_LOG.parent.mkdir(parents=True, exist_ok=True)
        with WARNING_LOG.open("a") as stream:
            stream.write(json.dumps(record, separators=(",", ":"),
                                    allow_nan=False) + "\n")
            stream.flush()
            os.fsync(stream.fileno())
    except (OSError, ValueError) as exc:
        print(f"panel-hue-warn: cannot append to {WARNING_LOG}: {exc}", flush=True)


def is_test(report):
    """A synthetic aircraft injected to exercise the chain.

    Marked rather than inferred, because guessing would eventually suppress a
    real warning. A test fires the lights exactly as a real aircraft does, but
    never records a warning -- so it cannot consume the cooldown and blind the
    system to the next real one. That happened for real: a test at 14:33 left a
    ten-minute hole during which an audible aircraft went unannounced.
    """
    return bool(report.get("test") or (report.get("prediction") or {}).get("test"))


# The audibility floor: the panel's model calls an aircraft audible at 5 dBA
# over the ambient. Ambient comes from settings (the same number the scorer
# uses), so the light and the panel agree about what "hearable" means.
def audible_floor_dba():
    return panel_settings.number("ambient_dba", "ADSB_AMBIENT_DBA",
                                 40.0, minimum=25.0, maximum=70.0) + 5.0


# How far out the onset model may claim audibility. Spherical spreading alone
# (20 log r) overstates range at distance because it ignores air absorption,
# and a cap keeps one hot CPA estimate from promising minutes of warning the
# air will not deliver.
AUDIBLE_RANGE_CAP_M = 20000.0
KNOTS_TO_M_S = 0.514444


def sound_arrival_epoch(prediction, report=None):
    """When the aircraft's noise is projected to FIRST BE HEARD at the house.

    Not the loudest moment: N170US on 2026-08-17 was warned 28 s before its
    closest approach's sound arrived -- and was audible ~12 s after the flash
    anyway, because a LOUD aircraft crosses the audibility floor well before
    closest approach. The owner heard "16 seconds of notice" from a warning
    that was, against its own wrong target, on time.

    Model: from the CPA level, spherical spreading (20 log r) gives the
    radius where the level first reaches the audible floor; the aircraft's
    own speed says when it enters that radius; the sound then needs its
    travel time from there. Falls back to CPA + travel when speed or level
    is missing, and never returns later than the CPA sound arrival.
    """
    at = prediction.get("at_epoch")
    if not isinstance(at, (int, float)):
        return None
    slant = prediction.get("slant_distance_m")
    if not (isinstance(slant, (int, float)) and slant > 0):
        return at
    peak_arrival = at + slant / SPEED_OF_SOUND_M_S

    level = prediction.get("noise_index")
    speed_kt = (report or {}).get("speed_kt")
    floor = audible_floor_dba()
    if (not isinstance(level, (int, float)) or level <= floor
            or not isinstance(speed_kt, (int, float)) or speed_kt <= 0):
        # Barely audible at its loudest, or no kinematics to project with:
        # onset and peak are the same moment for our purposes.
        return peak_arrival

    audible_radius = min(AUDIBLE_RANGE_CAP_M,
                         slant * 10.0 ** ((level - floor) / 20.0))
    if audible_radius <= slant:
        return peak_arrival
    # The run-in: distance along track between entering the audible sphere
    # and closest approach, at the aircraft's own speed.
    lateral = math.sqrt(audible_radius ** 2 - slant ** 2)
    onset = at - lateral / (speed_kt * KNOTS_TO_M_S)
    heard = onset + audible_radius / SPEED_OF_SOUND_M_S
    return min(heard, peak_arrival)


def choose(status, now, require_armed=True):
    """The aircraft worth lighting a room for, or None.

    Returns (report, band, seconds_until_heard).

    When require_armed=False the armed() gate is skipped so the caller can
    discover what WOULD HAVE fired and log it as a suppressed decision. The
    lights are never touched from that path; only the outer loop logs.
    """
    if require_armed and not armed():
        return None
    for report in (status.get("adsb_predictions") or []):
        prediction = report.get("prediction") or {}
        heard_at = sound_arrival_epoch(prediction, report)
        if heard_at is None:
            continue
        # The loudest sound this pass will deliver: closest approach plus its
        # travel time. Once THAT is behind us the pass is over; but an
        # aircraft that is merely already audible (onset in the past, peak
        # still coming) fires immediately -- it is loud NOW, and skipping it
        # would silence exactly the late-detection case.
        at = prediction.get("at_epoch")
        slant = prediction.get("slant_distance_m")
        peak_at = (at + slant / SPEED_OF_SOUND_M_S
                   if isinstance(slant, (int, float)) and slant > 0 else at)
        if now > peak_at:
            continue
        left = max(0.0, heard_at - now)
        if left > lead_seconds():
            continue
        band = prediction.get("loudness_band")
        if band in warn_bands():
            return report, band, left
        # The third state. Not measured is not the same as not loud.
        if (warn_on_unscored_overhead() and prediction.get("noise_index") is None
                and prediction.get("proximity") == "OVERHEAD"):
            return report, "UNKNOWN", left
    return None


def choose_unlocated(status, require_armed=True):
    """A rostered airframe the receiver hears but has never located, or None.

    Deliberately checked only when `choose` found nothing. A located aircraft
    carries real geometry and a real countdown; an unlocated one carries
    neither, and letting it pre-empt a precise warning would trade information
    for noise. This fires only in the case where the alternative is silence.

    There is no `left` to return. The caller must not invent one.

    When require_armed=False the armed() gate is skipped so the caller can
    discover what WOULD HAVE fired and log it as a suppressed decision.
    """
    if require_armed and not armed():
        return None
    for entry in (status.get("adsb_heard_unlocated") or []):
        if str(entry.get("operator_kind") or "").upper() in warn_unlocated_kinds():
            return entry
    return None


# One signature per OPERATOR KIND, the same in every room, by owner decision
# (2026-08-17). The colour now says WHAT is coming, not which room you are in:
#
#   normal aircraft    steady purple       (calm; no alternation, owner 2026-08-17)
#   air ambulance      white / blue        (calm, medical)
#   police             red / blue          (patrol light bar, double tempo)
#
# This puts red in the bedroom for police aircraft, which handoff §6 avoided
# so an aircraft warning could not be confused with the medical alarm. The
# owner ordered this palette knowing that, and the police signature is
# red-AND-blue alternation -- a shape the steady medical red never has.
# Recorded here so a later reader does not quietly revert it.
KIND_PALETTES = {
    "AIR_AMBULANCE": [XY_WHITE, XY_BLUE],
    "POLICE": [XY_RED, XY_BLUE],
}
DEFAULT_PALETTE = [XY_PURPLE]


def alternate_seconds_for(kind):
    """How fast this kind's colours swap. Police alternate at twice the
    normal rate (owner decision 2026-08-17) -- the urgency of a light bar is
    its tempo as much as its colours. Still well inside the bridge's write
    tolerance: two lights at 0.6 s is ~3.3 writes/second against the roughly
    ten per second where it starts dropping commands."""
    if str(kind or "").upper() == "POLICE":
        return ALTERNATE_SECONDS / 2.0
    return ALTERNATE_SECONDS


def zones(kind=None):
    """Which lights flash, in which colours, at what brightness.

    Each zone carries a LIST of colours. One colour is a steady flash; more than
    one alternates between them for the duration, which is far harder to mistake
    for a lamp someone left on than any single colour is. Every zone gets the
    SAME palette -- uniform across rooms -- chosen by the aircraft's operator
    kind, never by the room.
    """
    palette = KIND_PALETTES.get(str(kind or "").upper(), DEFAULT_PALETTE)
    out = [(LIGHTS, palette, ALERT_BRIGHTNESS)]
    if ALERT_LIGHTS:
        out.append((ALERT_LIGHTS, palette, ALERT_BRIGHTNESS))
    return out


def warn(band, reason, still_inbound=None, kind=None, hold_orange_seconds=0.0):
    """Flash every zone, then put every light back exactly as it was.

    Restoration runs in a finally: a failure partway through must not leave a
    bedroom lit. If restoring a light fails, that is reported rather than
    swallowed, because the household needs to know a lamp was left on.

    `still_inbound` is re-checked each tick. Without it the flash runs its full
    duration regardless of what the aircraft actually did -- which the owner
    saw: the panel cleared while the lights kept going. A warning that outlives
    the thing it is warning about teaches people to ignore it.

    `hold_orange_seconds` > 0 means the warning fired LATE -- with less than
    the normal notice before the sound arrives. The constant orange comes
    FIRST (owner decision 2026-08-17): "sooner than usual" opens the warning,
    and the flash lands at the end of the hold, right as the sound arrives.
    """
    plan = zones(kind)
    alternate = alternate_seconds_for(kind)
    captured, colours, errors = {}, {}, []

    for light_ids, palette, _fallback in plan:
        for light_id in light_ids:
            state, error = capture(light_id)
            if error is not None:
                errors.append(f"{light_id}: {error}")
                continue
            captured[light_id] = state
            # Brightness is RELATIVE to what this light was just doing, and
            # PER COLOUR: each palette colour gets its own drive level so the
            # perceived light steps up equally whether the colour is an
            # efficient white or a dim saturated blue.
            colours[light_id] = (palette,
                                 [flash_brightness(state, c) for c in palette])

    if not captured:
        return errors or ["no lights could be read"]

    try:
        print(f"panel-hue-warn: warned — {reason}", flush=True)
        cleared = False
        # Late-notice hold: constant orange FIRST, opening the warning with
        # "sooner than usual", so the flash lands at the end of the hold,
        # right as the sound arrives. Steady on purpose -- and it ends early
        # with the all-clear if the aircraft stops being inbound.
        if hold_orange_seconds > 0:
            for light_id in captured:
                # The hold's brightness is computed against ORANGE's own
                # efficacy: saturated orange emits far fewer lumens per bri
                # step than white, and at a naive "room + boost" drive it read
                # as no change against a 2700 K room (owner observation,
                # 2026-08-17). luminance-compensated it lands visibly above.
                apply_state(light_id, {"on": True,
                                       "bri": flash_brightness(
                                           captured[light_id], XY_ORANGE),
                                       "xy": XY_ORANGE, "alert": "none",
                                       "transitiontime": 2})
            print(f"panel-hue-warn: late notice — opening with constant orange "
                  f"{hold_orange_seconds:.0f}s, flash to follow as the sound "
                  f"arrives", flush=True)
            held = 0.0
            while held < hold_orange_seconds:
                tick = min(1.0, hold_orange_seconds - held)
                time.sleep(tick)
                held += tick
                if still_inbound is not None and not still_inbound():
                    cleared = True
                    break
                # Re-assert the steady orange every tick. Zigbee drops frames:
                # on 2026-08-17 one of two bedroom bulbs missed its single
                # write and silently sat unchanged through a whole warning.
                # A steady signal must self-heal exactly like an alternating
                # one does by construction.
                for light_id in captured:
                    apply_state(light_id, {"on": True,
                                           "bri": flash_brightness(
                                               captured[light_id], XY_ORANGE),
                                           "xy": XY_ORANGE,
                                           "transitiontime": 0})
        if not cleared:
            for light_id in captured:
                # Per-light colour and brightness, from whichever zone claimed
                # this light. Reusing the loop variables left over from the
                # capture pass applies the LAST zone's settings to every light --
                # which is exactly what happened: the bedroom went red at the
                # kitchen's colour.
                palette, brightnesses = colours[light_id]
                state = {"on": True, "bri": brightnesses[0], "xy": palette[0],
                         "transitiontime": 2}
                # A single-colour zone is STEADY -- on at the relative
                # brightness, no breathe, no alternation. An alternating zone
                # drives its own colour writes below.
                _, error = apply_state(light_id, state)
                if error is not None:
                    errors.append(f"{light_id}: {error}")
            # Sleep in slices, re-arming the breathe as it expires. A single
            # long sleep would leave the light solid for the tail of a flash.
            elapsed, step = 0.0, 0
            while elapsed < FLASH_SECONDS:
                tick = min(alternate, FLASH_SECONDS - elapsed)
                time.sleep(tick)
                elapsed += tick
                if elapsed >= FLASH_SECONDS:
                    break
                # Ended early because the aircraft is no longer inbound, not
                # because the timer expired. Say so with the all-clear rather
                # than just stopping.
                if still_inbound is not None and not still_inbound():
                    cleared = True
                    break
                step += 1
                for light_id in captured:
                    palette, brightnesses = colours[light_id]
                    if len(palette) > 1:
                        # transitiontime 0: snap between colours. A fade reads
                        # as one drifting colour rather than two alternating
                        # ones. Brightness follows the colour so the perceived
                        # level stays constant across the alternation.
                        apply_state(light_id, {"xy": palette[step % len(palette)],
                                               "bri": brightnesses[step % len(palette)],
                                               "transitiontime": 0})
                    else:
                        # Re-assert the steady colour every tick: Zigbee drops
                        # frames, and a bulb that missed the one opening write
                        # would otherwise sit unchanged through the whole
                        # warning -- which happened live on 2026-08-17.
                        apply_state(light_id, {"on": True, "xy": palette[0],
                                               "bri": brightnesses[0],
                                               "transitiontime": 0})
        if cleared:
            for light_id in captured:
                apply_state(light_id, {"on": True, "bri": ALL_CLEAR_BRIGHTNESS,
                                       "xy": XY_GREEN, "alert": "none",
                                       "transitiontime": 3})
            print("panel-hue-warn: all clear — aircraft is past", flush=True)
            time.sleep(ALL_CLEAR_SECONDS)
    finally:
        for light_id, state in captured.items():
            # Verified restore: written, read back, retried. A bridge "OK"
            # is not evidence the bulb heard it.
            error = restore_verified(light_id, state)
            if error is not None:
                errors.append(f"{light_id}: NOT RESTORED: {error}")
                print(f"panel-hue-warn: light {light_id} may have been left on: "
                      f"{error}", flush=True)
    return errors


def _terminate(signum, _frame):
    """Turn SIGTERM into an exception so `finally` blocks run.

    Default SIGTERM handling kills the process outright. If that lands during
    the flash -- `systemctl stop`, a reboot, a package upgrade -- the restore in
    `warn()` never executes and the lamp is left on, which is the single
    outcome this whole design exists to prevent.
    """
    raise SystemExit(f"panel-hue-warn: signal {signum}; restoring and exiting")


def main():
    global BRIDGE, USERNAME
    signal.signal(signal.SIGTERM, _terminate)
    signal.signal(signal.SIGINT, _terminate)
    BRIDGE = require("HUE_BRIDGE", BRIDGE)
    USERNAME = require("HUE_USERNAME", USERNAME)
    if not LIGHTS:
        raise SystemExit("panel-hue-warn: HUE_LIGHTS is required (comma-separated ids)")

    last_warned = 0.0
    last_test = 0.0
    # Announced on change, not every second. A disarmed warning system must
    # say so -- silence here is indistinguishable from a broken bridge, and
    # this file exists because that distinction matters.
    was_armed = None
    # Announced on change, like arming: a suppressed warning must say why.
    was_quiet = None
    # Hexes already flashed for while unlocated. An unlocated contact stays in
    # the feed for up to 90 s after its last message, so without this it would
    # re-fire every cooldown for the whole contact. Entries are dropped when the
    # airframe leaves the feed, so a genuine second arrival flashes again.
    warned_unlocated = {}
    # (hex, reason) -> last time a suppressed decision was logged, so a 30 s
    # approach yields one row, not thirty.
    suppressed_logged = {}
    while True:
        now = time.time()
        errors, subject = [], None
        try:
            with STATUS_JSON.open() as stream:
                status = json.load(stream)
        except (OSError, ValueError) as exc:
            status, errors = {}, [f"cannot read the aircraft feed: {exc}"]

        if armed() != was_armed:
            was_armed = armed()
            print("panel-hue-warn: " + ("warnings ARMED" if was_armed else
                  "warnings DISARMED by hue_enabled=false — nothing will flash, "
                  "including air ambulances and unscored aircraft overhead"),
                  flush=True)

        quiet = in_quiet_hours(now)
        if quiet != was_quiet:
            start, end = quiet_hours_range()
            if quiet:
                print(f"panel-hue-warn: QUIET HOURS — suppressed: quiet_hours "
                      f"({start:02.0f}:00–{end:02.0f}:00 {QUIET_TZ.key}); no light "
                      f"warnings of any kind, including tests, until they end",
                      flush=True)
            elif was_quiet:   # only announce an ending that actually happened
                print("panel-hue-warn: quiet hours ended — warnings active again",
                      flush=True)
            was_quiet = quiet

        if status:
            is_armed = armed()
            # choose() runs regardless of armed state and quiet hours: a
            # suppressed warning is still a warning DECISION, and the review
            # log must hold it. require_armed=False so the outer loop is the
            # single gate, not the inner function. Lights are never touched
            # from the disarmed or quiet branches.
            picked = choose(status, now, require_armed=False)
            if picked and not is_armed:
                # Disarmed: log what WOULD have fired, then stop.
                report, band, left = picked
                key = (report.get("hex"), "disarmed")
                if now - suppressed_logged.get(key, 0.0) >= SUPPRESS_LOG_WINDOW_S:
                    suppressed_logged[key] = now
                    log_warning(warning_record(report, band, left, fired=False,
                                               suppressed_by="disarmed",
                                               testing=is_test(report), now=now))
            elif picked and quiet:
                report, band, left = picked
                key = (report.get("hex"), "quiet_hours")
                if now - suppressed_logged.get(key, 0.0) >= SUPPRESS_LOG_WINDOW_S:
                    suppressed_logged[key] = now
                    log_warning(warning_record(report, band, left, fired=False,
                                               suppressed_by="quiet_hours",
                                               testing=is_test(report), now=now))
            elif picked:
                report, band, left = picked
                testing = is_test(report)
                # A test bypasses the cooldown so it always demonstrates, and
                # never sets it so it cannot suppress the next real aircraft.
                if testing or now - last_warned >= cooldown_seconds():
                    subject = (report.get("registration") or report.get("callsign")
                               or report.get("hex"))
                    if not testing:
                        last_warned = now
                    watched = report.get("hex")

                    def still_inbound(_hex=watched, _testing=testing):
                        """Is that same aircraft still forecast to pass?

                        A test aircraft is injected once and never updated, so
                        it would 'clear' on the very first tick; tests hold for
                        the full duration so they demonstrate the real thing.
                        """
                        if _testing:
                            return True
                        try:
                            with STATUS_JSON.open() as fresh:
                                current = json.load(fresh)
                        except (OSError, ValueError):
                            return True   # unknown is not cleared
                        return any((r.get("hex") == _hex)
                                   for r in (current.get("adsb_predictions") or []))

                    # Fired later than the intended notice? Hold orange after
                    # the flash until the sound is projected to arrive.
                    hold = 0.0
                    if left < LATE_NOTICE_SECONDS:
                        hold = max(0.0, min(left - FLASH_SECONDS,
                                            LATE_HOLD_CAP_SECONDS))
                    log_warning(warning_record(report, band, left, fired=True,
                                               hold_s=hold, testing=testing,
                                               now=now))
                    errors += warn(band, f"{subject} {band} heard in {left:.0f}s"
                                         + (f" [LATE — under {LATE_NOTICE_SECONDS:.0f}s notice]" if hold else "")
                                         + (" [TEST — cooldown untouched]" if testing else ""),
                                   still_inbound=still_inbound,
                                   kind=report.get("operator_kind"),
                                   hold_orange_seconds=hold)
                    if testing:
                        last_test = now
                else:
                    key = (report.get("hex"), "cooldown")
                    if now - suppressed_logged.get(key, 0.0) >= SUPPRESS_LOG_WINDOW_S:
                        suppressed_logged[key] = now
                        log_warning(warning_record(report, band, left, fired=False,
                                                   suppressed_by="cooldown",
                                                   testing=testing, now=now))
            elif not quiet:
                # Nothing located is worth a warning. Fall back to anything the
                # receiver is hearing but cannot place -- the case that produced
                # silence for N826LF on 2026-08-13.
                heard = choose_unlocated(status, require_armed=False)
                if heard is not None:
                    heard_hex = heard.get("hex")
                    if not is_armed:
                        # Disarmed: log what WOULD have fired, then stop.
                        key = (heard_hex, "disarmed")
                        if now - suppressed_logged.get(key, 0.0) >= SUPPRESS_LOG_WINDOW_S:
                            suppressed_logged[key] = now
                            log_warning(warning_record(heard, "UNLOCATED", None,
                                                       fired=False,
                                                       suppressed_by="disarmed",
                                                       now=now))
                    elif (heard_hex not in warned_unlocated
                            and now - last_warned >= cooldown_seconds()):
                        last_warned = now
                        warned_unlocated[heard_hex] = now
                        subject = heard.get("reg") or heard_hex

                        def still_heard(_hex=heard_hex):
                            """Is it still being received?

                            The only 'still happening' test available without a
                            position. A read failure holds the warning: unknown
                            is not cleared.
                            """
                            try:
                                with STATUS_JSON.open() as fresh:
                                    current = json.load(fresh)
                            except (OSError, ValueError):
                                return True
                            return any(e.get("hex") == _hex for e in
                                       (current.get("adsb_heard_unlocated") or []))

                        log_warning(warning_record(
                            {"hex": heard_hex, "registration": heard.get("reg"),
                             "callsign": heard.get("callsign"),
                             "operator_kind": heard.get("operator_kind")},
                            "UNLOCATED", None, fired=True, now=now))
                        errors += warn(
                            "UNLOCATED",
                            f"{subject} heard, position unknown — no countdown possible",
                            still_inbound=still_heard,
                            kind=heard.get("operator_kind"))

            # Forget contacts that have left the feed, so a later arrival fires
            # again. Only when the feed actually read: an unreadable status is
            # not evidence that an aircraft has gone.
            present = {e.get("hex") for e in (status.get("adsb_heard_unlocated") or [])}
            warned_unlocated = {h: t for h, t in warned_unlocated.items() if h in present}

        publish({
            "schema": 1, "written_at": time.time(),
            "armed": False,
            # Distinct from "armed" above, which records that this is an
            # advisory and not an alarm system. This one says whether any
            # trigger can fire at all.
            "warnings_enabled": armed(),
            # Named guard: when true, this — not a fault — is why nothing fires.
            "quiet_hours": in_quiet_hours(time.time()),
            "quiet_hours_window": "%02.0f:00–%02.0f:00 %s" % (
                *quiet_hours_range(), QUIET_TZ.key),
            "bridge": BRIDGE,
            "lights": LIGHTS,
            "alert_lights": ALERT_LIGHTS,
            "cooldown_s": cooldown_seconds(),
            "last_warned_at": last_warned or None,
            # Recorded separately so a test is never mistaken for a real
            # warning when reading back why the light did or did not fire.
            "last_test_at": last_test or None,
            "cooldown_remaining_s": (max(0.0, COOLDOWN_SECONDS - (time.time() - last_warned))
                                     if last_warned else 0.0),
            "last_subject": subject,
            # Named, never a bare boolean: a guard that blocks without saying
            # why is worse than no guard.
            "errors": errors or None,
            "healthy": not errors,
        })
        for error in errors:
            print(f"panel-hue-warn: {error}", flush=True)
        time.sleep(POLL_SECONDS)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(0)

#!/usr/bin/env python3
"""Flash a Hue light when something loud is about to pass over the house.

The design constraints below are not preferences. Each came out of the original
discussion recorded in docs/design/pi-panel/ADSB-HANDOFF.md §6, and every one of
them describes a way this feature could do harm if built carelessly.

1. IT MUST NOT LOOK LIKE A MEDICAL ALARM
   The bedside panel reserves klaxon red for high-priority physiological alarm
   and it "appears nowhere else". A light that turns a bedroom red at 3am, for
   an aeroplane, teaches the household to distrust the colour that matters. The
   aircraft channel is the radar's cyan, and amber only for the loudest band.

2. IT MUST RESTORE WHAT IT FOUND
   This is the one that can actually hurt: leaving a bedroom lamp on at 3am, or
   leaving it a colour it was never set to. The previous state of every light
   touched is captured BEFORE the first change and restored afterwards --
   including on failure, and including on shutdown. A light that was off goes
   back off; a light that was warm white at 40% goes back to warm white at 40%.

3. IT MUST NOT FIRE PER AIRCRAFT
   Portland traffic is continuous. Without a cooldown this would strobe a
   bedroom all evening and be unplugged within a day, which is the same as not
   existing. One warning, then quiet for the cooldown.

4. IT MUST FAIL LOUDLY
   A silent failure here is indistinguishable from a quiet sky, which is exactly
   the state this system refuses to conflate. Bridge unreachable, auth rejected,
   light missing: all logged with the blocker named, and surfaced in the status
   file the panel reads.

5. IT MUST NOT BE THE ALARM
   This is an early warning that a noise is coming, so it can be braced for. It
   is not armed, it controls nothing, and nothing depends on it.

Why the local v1 API
--------------------
`/api/<username>/lights/<id>/state` needs no cloud account and no internet: the
bridge is on the LAN and the Pi talks to it directly. v2 exists and v1 is
formally deprecated, but v1 is still supported on current bridges (this one
reports apiversion 1.78.0) and is dramatically simpler -- v2 requires an
event-stream client and TLS with a bridge-specific certificate for what is, for
us, three field writes.
"""

import json
import os
import signal
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

# Installed alongside this script in /usr/local/bin, which is not on the
# import path for a script invoked by absolute path.
sys.path.insert(0, str(Path(__file__).resolve().parent))
import panel_settings  # noqa: E402  (path must be set before the import)

BRIDGE = os.environ.get("HUE_BRIDGE")
USERNAME = os.environ.get("HUE_USERNAME")
LIGHTS = [x.strip() for x in os.environ.get("HUE_LIGHTS", "").split(",") if x.strip()]

# A second, optional set of lights that flashes at the same time in a different
# colour. Used here for the kitchen, so the warning is visible from a room the
# bedroom lights cannot be seen from.
#
# These may be RED. The bedroom set deliberately is not: the panel reserves red
# for medical alarm and a bedroom turning red at 3am for an aeroplane would
# erode that. A kitchen is a different room and a different context, and the
# bedroom stays cyan, so the distinction that matters is preserved.
ALERT_LIGHTS = [x.strip() for x in os.environ.get("HUE_ALERT_LIGHTS", "").split(",") if x.strip()]

STATUS_JSON = Path(os.environ.get(
    "ADSB_STATUS_JSON",
    "/home/chris/anxietywatch-panel/docs/design/pi-panel/direction-a-clinical/adsb_status.json"))
OUTPUT = Path(os.environ.get(
    "HUE_STATUS_JSON",
    "/home/chris/anxietywatch-panel/docs/design/pi-panel/direction-a-clinical/hue_status.json"))

POLL_SECONDS = float(os.environ.get("HUE_POLL_SECONDS", "1"))

# Only these bands warrant lighting a room. FAINT and a distant AUDIBLE do not:
# a warning that fires for everything is noise itself.
def warn_bands():
    """Which loudness bands fire the light, read live.

    An empty set is honoured rather than replaced by the default: "fire on
    nothing" is a legitimate request, and quietly re-arming a light someone
    deliberately disarmed would be worse than obeying them.
    """
    return panel_settings.words("hue_bands", "HUE_BANDS",
                                frozenset(("VERY LOUD", "LOUD")))


WARN_BANDS = warn_bands()

# An aircraft we could NOT score, passing directly overhead, also warrants a
# warning. Absence of a score is not evidence of quiet -- and air ambulances are
# over-represented among the aircraft that broadcast no category at all.
def warn_on_unscored_overhead():
    return panel_settings.flag("hue_warn_unscored", "HUE_WARN_UNSCORED", True)


WARN_ON_UNSCORED_OVERHEAD = warn_on_unscored_overhead()


def armed():
    """The master switch, checked before any trigger is evaluated.

    One switch rather than three. There are three independent paths to a
    flash -- a scored band, an unlocated air ambulance, and an unscored
    aircraft overhead -- and disabling only the obvious one leaves the light
    still firing while the operator believes it is off. That is the precise
    failure this project legislates against everywhere else, so the disable
    is a single gate rather than three things to remember.
    """
    return panel_settings.flag("hue_enabled", "HUE_ENABLED", True)

# Operator kinds that warrant a warning when the receiver hears them but never
# decodes a position. There is no geometry at all in this case -- no range, no
# countdown, no score -- so this trades a precise warning for an early vague
# one. The owner chose that trade on 2026-08-13, after N826LF was heard for two
# minutes at -33 dBm and produced nothing while being audible from the ground.
#
# AIR_AMBULANCE only, by default. The roster also carries Portland Police
# airframes, which the owner describes as "nearly constantly flying around" --
# firing on those unlocated would mean near-continuous flashing, which trains
# the eye to ignore the light and costs more than it buys. Add POLICE here
# deliberately if that judgement changes.
def warn_unlocated_kinds():
    return frozenset(k.upper() for k in panel_settings.words(
        "hue_unlocated_kinds", "HUE_UNLOCATED_KINDS",
        frozenset(("AIR_AMBULANCE",))))


WARN_UNLOCATED_KINDS = warn_unlocated_kinds()

# Fire no more than once per this window.
#
# 30 s, down from 10 minutes. The long cooldown existed to stop continuous
# Portland traffic strobing a bedroom all evening, but the band threshold does
# most of that work already -- only LOUD and above fire, which is a couple of
# aircraft a day. A short cooldown means two genuinely loud aircraft a minute
# apart both get announced, which is the case that matters and which a
# 10-minute window silently swallowed.
def cooldown_seconds():
    # 0 is allowed -- it means "never suppress" -- but a negative value would
    # make the comparison always true in a way that reads as a cooldown.
    return panel_settings.number("hue_cooldown_seconds", "HUE_COOLDOWN_SECONDS",
                                 30.0, minimum=0.0, maximum=3600.0)


COOLDOWN_SECONDS = cooldown_seconds()

# How long the warning lasts before the previous state is restored.
FLASH_SECONDS = float(os.environ.get("HUE_FLASH_SECONDS", "17"))

# The bridge's own `lselect` breathe stops after roughly 15 seconds. Any flash
# longer than that would sit solid for the remainder, so the alert is re-issued
# on this cadence to keep it pulsing for the whole duration.
ALERT_REFRESH_SECONDS = 14.0

# How often an alternating zone swaps colour. Slow enough to read as two
# distinct colours rather than a blur, fast enough to be obviously deliberate.
# At two lights this is under 2 writes/second, well inside what the bridge
# tolerates (it starts dropping commands past roughly ten per second).
ALTERNATE_SECONDS = float(os.environ.get("HUE_ALTERNATE_SECONDS", "1.2"))

# The all-clear tail: how long, and how bright. Dimmer than the warning, because
# it is closing punctuation rather than an alert.
ALL_CLEAR_SECONDS = float(os.environ.get("HUE_ALL_CLEAR_SECONDS", "3"))
ALL_CLEAR_BRIGHTNESS = max(1, min(254, int(os.environ.get("HUE_ALL_CLEAR_BRIGHTNESS", "120"))))


# The measured warning budget for a Providence departure is ~34 s, so a warning
# is only useful inside roughly that window. Firing 3 minutes ahead trains the
# household to ignore it.
def lead_seconds():
    # Capped at 300: the entire warning budget for a Life Flight departure off
    # the Providence pad is 34 seconds, so a lead of an hour is a typo, not a
    # preference.
    return panel_settings.number("hue_lead_seconds", "HUE_LEAD_SECONDS",
                                 45.0, minimum=1.0, maximum=300.0)


LEAD_SECONDS = lead_seconds()

# Hue CIE xy.
#
# The bedroom alternates PURPLE and ORANGE. Neither is red: red belongs to the
# medical alarm and appears nowhere else in this house's visual language, so a
# bedroom turning red for an aeroplane would erode the colour that means
# something is wrong with a person. The kitchen IS red -- a different room in a
# different context, where the job is to carry across a house.
#
# Purple is kept clear of blue, which at low brightness reads as an ordinary
# night-light rather than a warning. Orange is far enough from purple that the
# alternation reads as two distinct states rather than one drifting colour.
XY_PURPLE = [0.2919, 0.1327]
XY_ORANGE = [0.5820, 0.3901]
XY_CYAN = [0.17, 0.33]
XY_AMBER = [0.53, 0.42]
XY_RED = [0.675, 0.322]
# All-clear. Shown briefly when the warning ends, so the lights stopping is a
# statement rather than an absence -- "it has gone" reads differently from "the
# timer ran out", and only one of those is information.
XY_GREEN = [0.2100, 0.6800]

# Brightness of the warning itself, on Hue's 1-254 scale. Raised from 160 to
# 200 (+25%) at the owner's request after watching a live flash: the point is to
# be noticed from across a room without being the brightest thing in it. This
# does not affect what is restored afterwards -- the light's own brightness is
# captured before the flash and put back regardless.
FLASH_BRIGHTNESS = max(1, min(254, int(os.environ.get("HUE_FLASH_BRIGHTNESS", "200"))))

# Hue's brightness scale is 1-254 (0 is not valid; off is a separate state), so
# 90% is 229. Used by every zone now that they share one signature.
ALERT_BRIGHTNESS = max(1, min(254, int(os.environ.get("HUE_ALERT_BRIGHTNESS", "229"))))

TIMEOUT = float(os.environ.get("HUE_TIMEOUT_SECONDS", "4"))


def require(name, value):
    if not value:
        raise SystemExit(
            f"panel-hue-warn: {name} is required; set it in a systemd drop-in "
            f"(systemctl edit panel-hue-warn). The bridge address and username "
            f"are credentials and must never be committed.")
    return value


def call(method, path, body=None):
    """One bridge request. Returns (payload, error) -- never raises.

    The bridge answers 200 with an error object in the body rather than an HTTP
    status, so the payload is inspected for one. Treating HTTP 200 as success
    would report a rejected credential as a successful write.
    """
    url = f"http://{BRIDGE}/api/{USERNAME}{path}"
    data = json.dumps(body).encode() if body is not None else None
    request = urllib.request.Request(url, data=data, method=method,
                                     headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(request, timeout=TIMEOUT) as response:
            payload = json.loads(response.read() or b"null")
    except urllib.error.HTTPError as exc:
        return None, f"bridge returned HTTP {exc.code}"
    except (urllib.error.URLError, TimeoutError, OSError) as exc:
        return None, f"bridge {BRIDGE} unreachable: {exc}"
    except ValueError as exc:
        return None, f"bridge returned unparseable JSON: {exc}"

    if isinstance(payload, list):
        for item in payload:
            if isinstance(item, dict) and "error" in item:
                detail = item["error"]
                return None, (f"bridge rejected the request: "
                              f"{detail.get('description')} ({detail.get('address')})")
    return payload, None


def capture(light_id):
    """The light's current state, or (None, error).

    Captured BEFORE anything is changed. Without this the warning cannot be
    undone, and an unattended light left on overnight is a worse outcome than no
    warning at all.
    """
    payload, error = call("GET", f"/lights/{light_id}")
    if error is not None:
        return None, error
    state = (payload or {}).get("state") or {}
    if "on" not in state:
        return None, f"light {light_id} reported no state"

    # Colour and brightness are captured whether the light is on or OFF.
    #
    # Restoring only {"on": false} looks correct -- the light is off, as it was
    # -- but leaves the bridge holding the FLASH colour as that light's stored
    # state. The next time someone switches the fixture on by hand it comes up
    # cyan at brightness 160 instead of their warm white. The failure is
    # invisible at the time and surfaces hours later, which makes it worse than
    # an obvious one.
    #
    # Verified against the real bridge: a PUT carrying bri/ct alongside
    # "on": false is accepted with no error and does not light the room, so the
    # full state can be put back without a second flash.
    restore = {"on": bool(state["on"])}
    if "bri" in state:
        restore["bri"] = state["bri"]
    # `colormode` decides which of xy/ct/hs is authoritative; restoring the
    # wrong one changes the colour even when every value is faithfully copied.
    mode = state.get("colormode")
    if mode == "xy" and "xy" in state:
        restore["xy"] = state["xy"]
    elif mode == "ct" and "ct" in state:
        restore["ct"] = state["ct"]
    elif mode == "hs":
        if "hue" in state:
            restore["hue"] = state["hue"]
        if "sat" in state:
            restore["sat"] = state["sat"]
    return restore, None


def apply_state(light_id, state):
    return call("PUT", f"/lights/{light_id}/state", state)


def publish(document):
    try:
        OUTPUT.parent.mkdir(parents=True, exist_ok=True)
        tmp = OUTPUT.with_name(f".{OUTPUT.name}.tmp")
        with tmp.open("w") as stream:
            json.dump(document, stream, separators=(",", ":"), allow_nan=False)
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(tmp, 0o644)
        os.replace(tmp, OUTPUT)
    except OSError as exc:
        print(f"panel-hue-warn: cannot write {OUTPUT}: {exc}", flush=True)


def is_test(report):
    """A synthetic aircraft injected to exercise the chain.

    Marked rather than inferred, because guessing would eventually suppress a
    real warning. A test fires the lights exactly as a real aircraft does, but
    never records a warning -- so it cannot consume the cooldown and blind the
    system to the next real one. That happened for real: a test at 14:33 left a
    ten-minute hole during which an audible aircraft went unannounced.
    """
    return bool(report.get("test") or (report.get("prediction") or {}).get("test"))


def choose(status, now):
    """The aircraft worth lighting a room for, or None.

    Returns (report, band, seconds_away).
    """
    if not armed():
        return None
    for report in (status.get("adsb_predictions") or []):
        prediction = report.get("prediction") or {}
        at = prediction.get("at_epoch")
        if not isinstance(at, (int, float)):
            continue
        left = at - now
        if left < 0 or left > lead_seconds():
            continue
        band = prediction.get("loudness_band")
        if band in warn_bands():
            return report, band, left
        # The third state. Not measured is not the same as not loud.
        if (warn_on_unscored_overhead() and prediction.get("noise_index") is None
                and prediction.get("proximity") == "OVERHEAD"):
            return report, "UNKNOWN", left
    return None


def choose_unlocated(status):
    """A rostered airframe the receiver hears but has never located, or None.

    Deliberately checked only when `choose` found nothing. A located aircraft
    carries real geometry and a real countdown; an unlocated one carries
    neither, and letting it pre-empt a precise warning would trade information
    for noise. This fires only in the case where the alternative is silence.

    There is no `left` to return. The caller must not invent one.
    """
    if not armed():
        return None
    for entry in (status.get("adsb_heard_unlocated") or []):
        if str(entry.get("operator_kind") or "").upper() in warn_unlocated_kinds():
            return entry
    return None


def zones(band):
    """Which lights flash, in which colours, at what brightness.

    Each zone carries a LIST of colours. One colour is a steady flash; more than
    one alternates between them for the duration, which is far harder to mistake
    for a lamp someone left on than any single colour is.

    The bedroom alternates purple and orange. Neither is red -- that belongs to
    medical alarm, and a bedroom turning red for an aeroplane erodes the colour
    that means something is wrong with a person. The kitchen is red, because it
    is a different room in a different context and needs to carry across a house.
    """
    # Every zone now flashes the SAME pattern, at the owner's explicit request:
    # purple alternating with red, at 90%. The earlier per-room split (purple in
    # the bedroom, red in the kitchen) is gone -- one unmistakable signature
    # everywhere is easier to recognise half asleep than a colour that has to be
    # decoded per room.
    #
    # This does put red in the bedroom, which the original design in handoff §6
    # avoided so an aircraft warning could not be confused with a medical alarm.
    # The owner decided otherwise, knowing that. Recorded here so it is not
    # quietly reverted by a later reader who only finds the §6 note.
    palette = [XY_PURPLE, XY_RED]
    out = [(LIGHTS, palette, ALERT_BRIGHTNESS)]
    if ALERT_LIGHTS:
        out.append((ALERT_LIGHTS, palette, ALERT_BRIGHTNESS))
    return out


def warn(band, reason, still_inbound=None):
    """Flash every zone, then put every light back exactly as it was.

    Restoration runs in a finally: a failure partway through must not leave a
    bedroom lit. If restoring a light fails, that is reported rather than
    swallowed, because the household needs to know a lamp was left on.

    `still_inbound` is re-checked each tick. Without it the flash runs its full
    duration regardless of what the aircraft actually did -- which the owner
    saw: the panel cleared while the lights kept going. A warning that outlives
    the thing it is warning about teaches people to ignore it.
    """
    plan = zones(band)
    captured, colours, errors = {}, {}, []

    for light_ids, palette, brightness in plan:
        for light_id in light_ids:
            state, error = capture(light_id)
            if error is not None:
                errors.append(f"{light_id}: {error}")
                continue
            captured[light_id] = state
            colours[light_id] = (palette, brightness)

    if not captured:
        return errors or ["no lights could be read"]

    try:
        for light_id in captured:
            # Per-light colour and brightness, from whichever zone claimed this
            # light. Reusing the loop variables left over from the capture pass
            # applies the LAST zone's settings to every light -- which is exactly
            # what happened: the bedroom went red at the kitchen's colour. The
            # bedroom must never go red; that belongs to medical alarm.
            palette, brightness = colours[light_id]
            state = {"on": True, "bri": brightness, "xy": palette[0],
                     "transitiontime": 2}
            # A single-colour zone leans on the bridge's own ~15 s breathe. An
            # alternating zone drives itself, and asking for `lselect` as well
            # would fight the colour writes.
            if len(palette) == 1:
                state["alert"] = "lselect"
            _, error = apply_state(light_id, state)
            if error is not None:
                errors.append(f"{light_id}: {error}")
        print(f"panel-hue-warn: warned — {reason}", flush=True)
        # Sleep in slices, re-arming the breathe as it expires. A single long
        # sleep would leave the light solid for the tail of a long flash.
        elapsed, step, since_refresh, cleared = 0.0, 0, 0.0, False
        while elapsed < FLASH_SECONDS:
            tick = min(ALTERNATE_SECONDS, FLASH_SECONDS - elapsed)
            time.sleep(tick)
            elapsed += tick
            since_refresh += tick
            if elapsed >= FLASH_SECONDS:
                break
            # Ended early because the aircraft is no longer inbound, not because
            # the timer expired. Say so with the all-clear rather than just
            # stopping.
            if still_inbound is not None and not still_inbound():
                cleared = True
                break
            step += 1
            for light_id in captured:
                palette, brightness = colours[light_id]
                if len(palette) > 1:
                    # transitiontime 0: snap between colours. A fade reads as
                    # one drifting colour rather than two alternating ones.
                    apply_state(light_id, {"xy": palette[step % len(palette)],
                                           "bri": brightness, "transitiontime": 0})
            if since_refresh >= ALERT_REFRESH_SECONDS:
                since_refresh = 0.0
                for light_id in captured:
                    if len(colours[light_id][0]) == 1:
                        apply_state(light_id, {"alert": "lselect"})
        if cleared:
            for light_id in captured:
                apply_state(light_id, {"on": True, "bri": ALL_CLEAR_BRIGHTNESS,
                                       "xy": XY_GREEN, "alert": "none",
                                       "transitiontime": 3})
            print("panel-hue-warn: all clear — aircraft is past", flush=True)
            time.sleep(ALL_CLEAR_SECONDS)
    finally:
        for light_id, state in captured.items():
            # Cancel the alert explicitly: it outlives a plain state write.
            _, error = apply_state(light_id, dict(state, alert="none",
                                                  transitiontime=4))
            if error is not None:
                errors.append(f"{light_id}: NOT RESTORED: {error}")
                print(f"panel-hue-warn: light {light_id} may have been left on: "
                      f"{error}", flush=True)
    return errors


def _terminate(signum, _frame):
    """Turn SIGTERM into an exception so `finally` blocks run.

    Default SIGTERM handling kills the process outright. If that lands during
    the flash -- `systemctl stop`, a reboot, a package upgrade -- the restore in
    `warn()` never executes and the lamp is left on, which is the single
    outcome this whole design exists to prevent.
    """
    raise SystemExit(f"panel-hue-warn: signal {signum}; restoring and exiting")


def main():
    global BRIDGE, USERNAME
    signal.signal(signal.SIGTERM, _terminate)
    signal.signal(signal.SIGINT, _terminate)
    BRIDGE = require("HUE_BRIDGE", BRIDGE)
    USERNAME = require("HUE_USERNAME", USERNAME)
    if not LIGHTS:
        raise SystemExit("panel-hue-warn: HUE_LIGHTS is required (comma-separated ids)")

    last_warned = 0.0
    last_test = 0.0
    # Announced on change, not every second. A disarmed warning system must
    # say so -- silence here is indistinguishable from a broken bridge, and
    # this file exists because that distinction matters.
    was_armed = None
    # Hexes already flashed for while unlocated. An unlocated contact stays in
    # the feed for up to 90 s after its last message, so without this it would
    # re-fire every cooldown for the whole contact. Entries are dropped when the
    # airframe leaves the feed, so a genuine second arrival flashes again.
    warned_unlocated = {}
    while True:
        now = time.time()
        errors, subject = [], None
        try:
            with STATUS_JSON.open() as stream:
                status = json.load(stream)
        except (OSError, ValueError) as exc:
            status, errors = {}, [f"cannot read the aircraft feed: {exc}"]

        if armed() != was_armed:
            was_armed = armed()
            print("panel-hue-warn: " + ("warnings ARMED" if was_armed else
                  "warnings DISARMED by hue_enabled=false — nothing will flash, "
                  "including air ambulances and unscored aircraft overhead"),
                  flush=True)

        if status:
            picked = choose(status, now)
            if picked:
                report, band, left = picked
                testing = is_test(report)
                # A test bypasses the cooldown so it always demonstrates, and
                # never sets it so it cannot suppress the next real aircraft.
                if testing or now - last_warned >= cooldown_seconds():
                    subject = (report.get("registration") or report.get("callsign")
                               or report.get("hex"))
                    if not testing:
                        last_warned = now
                    watched = report.get("hex")

                    def still_inbound(_hex=watched, _testing=testing):
                        """Is that same aircraft still forecast to pass?

                        A test aircraft is injected once and never updated, so
                        it would 'clear' on the very first tick; tests hold for
                        the full duration so they demonstrate the real thing.
                        """
                        if _testing:
                            return True
                        try:
                            with STATUS_JSON.open() as fresh:
                                current = json.load(fresh)
                        except (OSError, ValueError):
                            return True   # unknown is not cleared
                        return any((r.get("hex") == _hex)
                                   for r in (current.get("adsb_predictions") or []))

                    errors += warn(band, f"{subject} {band} in {left:.0f}s"
                                         + (" [TEST — cooldown untouched]" if testing else ""),
                                   still_inbound=still_inbound)
                    if testing:
                        last_test = now
            else:
                # Nothing located is worth a warning. Fall back to anything the
                # receiver is hearing but cannot place -- the case that produced
                # silence for N826LF on 2026-08-13.
                heard = choose_unlocated(status)
                if heard is not None:
                    heard_hex = heard.get("hex")
                    if (heard_hex not in warned_unlocated
                            and now - last_warned >= cooldown_seconds()):
                        last_warned = now
                        warned_unlocated[heard_hex] = now
                        subject = heard.get("reg") or heard_hex

                        def still_heard(_hex=heard_hex):
                            """Is it still being received?

                            The only 'still happening' test available without a
                            position. A read failure holds the warning: unknown
                            is not cleared.
                            """
                            try:
                                with STATUS_JSON.open() as fresh:
                                    current = json.load(fresh)
                            except (OSError, ValueError):
                                return True
                            return any(e.get("hex") == _hex for e in
                                       (current.get("adsb_heard_unlocated") or []))

                        errors += warn(
                            "UNLOCATED",
                            f"{subject} heard, position unknown — no countdown possible",
                            still_inbound=still_heard)

            # Forget contacts that have left the feed, so a later arrival fires
            # again. Only when the feed actually read: an unreadable status is
            # not evidence that an aircraft has gone.
            present = {e.get("hex") for e in (status.get("adsb_heard_unlocated") or [])}
            warned_unlocated = {h: t for h, t in warned_unlocated.items() if h in present}

        publish({
            "schema": 1, "written_at": time.time(),
            "armed": False,
            # Distinct from "armed" above, which records that this is an
            # advisory and not an alarm system. This one says whether any
            # trigger can fire at all.
            "warnings_enabled": armed(),
            "bridge": BRIDGE,
            "lights": LIGHTS,
            "alert_lights": ALERT_LIGHTS,
            "cooldown_s": cooldown_seconds(),
            "last_warned_at": last_warned or None,
            # Recorded separately so a test is never mistaken for a real
            # warning when reading back why the light did or did not fire.
            "last_test_at": last_test or None,
            "cooldown_remaining_s": (max(0.0, COOLDOWN_SECONDS - (time.time() - last_warned))
                                     if last_warned else 0.0),
            "last_subject": subject,
            # Named, never a bare boolean: a guard that blocks without saying
            # why is worse than no guard.
            "errors": errors or None,
            "healthy": not errors,
        })
        for error in errors:
            print(f"panel-hue-warn: {error}", flush=True)
        time.sleep(POLL_SECONDS)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(0)

def armed():
    """The master switch, checked before any trigger is evaluated.

    One switch rather than three. There are three independent paths to a
    flash -- a scored band, an unlocated air ambulance, and an unscored
    aircraft overhead -- and disabling only the obvious one leaves the light
    still firing while the operator believes it is off. That is the precise
    failure this project legislates against everywhere else, so the disable
    is a single gate rather than three things to remember.
    """
    return panel_settings.flag("hue_enabled", "HUE_ENABLED", True)


# Quiet hours: NO light warning of any kind between midnight and 09:00
# Pacific, by owner decision 2026-08-17. "No matter what" -- scored bands,
# unscored-overhead, unlocated air ambulances, and injected tests are all
# behind this one gate, for the same reason the master switch is one gate:
# a quiet-hours rule that silences only the obvious path still lights the
# bedroom at 3am.
#
# The household's clock is Pacific wall time, DST included -- "midnight" means
# midnight on the bedside clock, so this is computed in America/Los_Angeles
# and nowhere else. Storage and logs stay UTC as always; this is presentation
# of a local policy, not a stored timestamp.
QUIET_TZ = ZoneInfo(os.environ.get("HUE_QUIET_TZ", "America/Los_Angeles"))


def quiet_hours_range():
    """(start_hour, end_hour) in local wall time. Equal values disable it."""
    start = panel_settings.number("hue_quiet_start_hour", "HUE_QUIET_START_HOUR",
                                  0.0, minimum=0.0, maximum=24.0)
    end = panel_settings.number("hue_quiet_end_hour", "HUE_QUIET_END_HOUR",
                                9.0, minimum=0.0, maximum=24.0)
    return start, end


def in_quiet_hours(now):
    """True when the wall clock in QUIET_TZ is inside the quiet window.

    Handles a window that wraps midnight (e.g. 22 -> 7) as well as the
    default 0 -> 9. A zero-length window means quiet hours are disabled.
    """
    start, end = quiet_hours_range()
    if start == end:
        return False
    local = datetime.fromtimestamp(now, QUIET_TZ)
    hour = local.hour + local.minute / 60.0 + local.second / 3600.0
    if start < end:
        return start <= hour < end
    return hour >= start or hour < end


#!/usr/bin/env python3
"""Cache the nearest METAR so noise events can capture the acoustic weather.

Temperature, wind, gusts, cloud deck and pressure all change how far and how
loud an aircraft carries -- a summer inversion can add more apparent dB than
the difference between two airframe classes. Nothing here predicts that; this
records the conditions so a later analysis (or a later microphone) has them.

Design rules, matching every other feed in this directory:

  - The PRESS PATH NEVER TOUCHES THE NETWORK. panel-hue-aircraft-label and
    panel-aircraft-report read the cache file this writes and record its age.
    If this poller is dead, events say "weather not measured", never block.
  - A failed fetch NEVER erases the last good observation. It is recorded
    beside it, with its own timestamp, and the reader decides what is stale.
  - The source is the public aviationweather.gov METAR API for a station the
    operator sets (default KPDX, the field whose traffic this watch scores).
    No credential, no home coordinate.
"""
import json
import os
import time
import urllib.error
import urllib.request
from pathlib import Path

STATION = os.environ.get("WEATHER_METAR_STATION", "KPDX")
CACHE = Path(os.environ.get("PANEL_WEATHER_CACHE", "/var/lib/panel-noise/weather.json"))
URL = ("https://aviationweather.gov/api/data/metar"
       f"?ids={STATION}&format=json&taf=false")
TIMEOUT_SECONDS = 15.0
USER_AGENT = "anxietywatch-panel-weather/1 (home station; contact: repo owner)"


def read_cache():
    try:
        with CACHE.open() as stream:
            doc = json.load(stream)
        return doc if isinstance(doc, dict) else {}
    except (OSError, ValueError):
        return {}


def write_cache(doc):
    CACHE.parent.mkdir(parents=True, exist_ok=True)
    tmp = CACHE.with_name(f".{CACHE.name}.tmp")
    with tmp.open("w") as stream:
        json.dump(doc, stream, separators=(",", ":"), sort_keys=True)
        stream.flush()
        os.fsync(stream.fileno())
    os.chmod(tmp, 0o644)
    os.replace(tmp, CACHE)


def fetch():
    request = urllib.request.Request(URL, headers={"User-Agent": USER_AGENT})
    with urllib.request.urlopen(request, timeout=TIMEOUT_SECONDS) as response:
        payload = json.load(response)
    if not isinstance(payload, list) or not payload or not isinstance(payload[0], dict):
        raise ValueError(f"unexpected METAR payload shape for {STATION}: {type(payload).__name__}")
    return payload[0]


def observation_from(metar):
    """Queryable projection plus the verbatim record. Absent stays absent."""
    def num(key):
        value = metar.get(key)
        return float(value) if isinstance(value, (int, float)) else None

    return {
        "station": metar.get("icaoId") or STATION,
        "observed_at_iso": metar.get("reportTime"),
        "temperature_c": num("temp"),
        "dewpoint_c": num("dewp"),
        "wind_dir_deg": num("wdir") if isinstance(metar.get("wdir"), (int, float)) else None,
        "wind_speed_kt": num("wspd"),
        "wind_gust_kt": num("wgst"),
        "visibility": metar.get("visib"),
        "altimeter_hpa": num("altim"),
        "clouds": metar.get("clouds"),
        "weather_string": metar.get("wxString"),
        "raw_metar": metar.get("rawOb"),
    }


def poll(now=None):
    now = time.time() if now is None else now
    cache = read_cache()
    try:
        observation = observation_from(fetch())
    except (OSError, ValueError, urllib.error.URLError) as exc:
        # The last good observation stays; the failure sits beside it, named.
        cache["last_error"] = {"at": now, "error": str(exc), "url_station": STATION}
        write_cache(cache)
        print(f"panel-weather-poll: fetch failed, last good observation kept: {exc}", flush=True)
        return 1
    write_cache({"schema": 1, "fetched_at": now, "source": "aviationweather.gov metar",
                 "observation": observation})
    print(f"panel-weather-poll: {observation.get('station')} "
          f"{observation.get('temperature_c')}degC wind {observation.get('wind_speed_kt')}kt",
          flush=True)
    return 0


if __name__ == "__main__":
    raise SystemExit(poll())

def route_for(callsign):
    """Where this flight came from and where it is going, or None.

    Keyed on the callsign rather than the airframe, because that is what a
    route belongs to. Returns None for the majority of traffic here: a private
    aircraft transmits its registration as its callsign and has no route at
    all, which is absence rather than failure.
    """
    if not isinstance(callsign, str):
        return None
    key = callsign.strip().upper()
    # A blank callsign is not a key. dump1090 reports them constantly, and one
    # reaching a dict lookup would match whatever happened to be stored under
    # "" and attribute a stranger's route to an unidentified aircraft. The
    # database CHECK forbids the row; this forbids the lookup.
    if not key:
        return None
    return flight_routes().get(key) or None


def resolved_type(hex_code):
    """The ICAO type designator known for this address, or None.

    Roster first: it is hand-verified and carries judgement a bulk lookup does
    not. Then whatever the enricher has learned. Never the emitter category --
    that is a weight bucket, not a designator, and writing one into the other
    conflated two vocabularies in a single column once already.
    """
    airframe = panel_loud_operators.lookup_hex(hex_code)
    if airframe is not None and airframe.get("type"):
        return airframe["type"]
    key = panel_loud_operators.normalise_hex(hex_code)
    entry = enriched_types().get(key) if key else None
    if isinstance(entry, dict) and entry.get("type"):
        return entry["type"]
    return None


# Per-type corrections to the class source level, in dB.
#
# The class table cannot express an airframe that is anomalous for its class.
# Kept deliberately tiny: an entry here is a claim that a specific type differs
# from everything else in its bucket, and each one names its evidence.
TYPE_SOURCE_OFFSET_DB = {
    # Cessna Skymaster. The rear pusher propeller works in the turbulent wake
    # of the front one, which drives its blade tips toward transonic speed and
    # makes it markedly louder than its airframe class suggests. The research
    # report puts it 5-8 dB above a conventional light twin, and its own light
    # twin reference (AEDT BEC58P, 72.2 dBA) is itself above the piston single
    # this model uses for `light` (GASEPV, 69.0) -- so the correction carries
    # both gaps. A labelled engineering estimate, not a measurement: no clean
    # certification figure for the type could be found.
    #
    # It earns its place because the owner has picked this type out by ear
    # twice, on 2026-08-13, including at 1.43 km.
    "C337": 9.5,
}


def type_offset_db(hex_code):
    """dB to add to the class source level for this specific airframe."""
    designator = resolved_type(hex_code)
    if designator is None:
        return 0.0
    return TYPE_SOURCE_OFFSET_DB.get(
        panel_airframe_types.normalise_type(designator) or "", 0.0)


def airframe_class(category, hex_code=None):
    """Coarse airframe class from the ADS-B emitter category.

    Returns None when the class cannot be established. Unknown is a third state:
    it must not be silently folded into 'jet', because that would let an
    unidentified return borrow a narrowbody's source level.

    When the emitter category is absent, the Mode S address is consulted against
    the operator roster. Roughly half the aircraft this receiver hears broadcast
    no category at all, and the air ambulances that generate the complaints here
    are over-represented in that group -- so without this fallback the loudest,
    lowest traffic over the station is precisely the traffic that scores
    nothing. The address is broadcast whether or not the category is, so this
    costs nothing and needs no network.
    """
    # 1. The curated roster: hand-verified, with provenance.
    # 2. The exact ICAO type learned from the public airframe database.
    #
    # Both beat the broadcast emitter category, which is the reverse of what
    # this function did until 2026-08-13. That ordering was justified as "the
    # aircraft's own broadcast is better evidence than our static table", which
    # sounds right and is not: the two do not describe the same property. The
    # emitter category is a WEIGHT bucket -- A1 means "under 15,500 lb", which
    # covers a Cessna 172, a TBM 850 and a King Air alike -- while a designator
    # names the airframe. A type is strictly more informative, never less.
    #
    # The cost was concrete. Every turboprop that broadcasts A1 -- TBM8, PC12,
    # C208, B350 -- was classed `light`, so the turboprop source level added
    # after the TBM 850 was missed on 2026-08-13 was dead code for exactly the
    # aircraft it was added for. Worse, a rostered helicopter broadcasting a
    # fixed-wing category would have been scored as a jet and lost the
    # rotorcraft approach penalty entirely.
    designator = resolved_type(hex_code)
    if designator is not None:
        klass = panel_airframe_types.classify(designator)
        if klass is not None:
            return klass

    # 3. The broadcast category, as a fallback when no type is known. Coarse,
    #    but roughly half of what this receiver hears carries nothing better.
    code = str(category or "").strip().upper()
    if code in ("A5", "A6"):
        return "heavy"
    if code in ("A3", "A4"):
        return "jet"
    if code in ("A1", "A2"):
        return "light"
    if code == "A7":
        return "rotorcraft"

    # 4. Unknown, and stays unknown. Never folded into "jet" on the grounds that
    #    most traffic is jets.
    return None


def thrust_phase(vertical_rate_fpm):
    """Flight phase from vertical rate, or None when the rate is not reported."""
    if not isinstance(vertical_rate_fpm, (int, float)):
        return None
    if vertical_rate_fpm >= CLIMB_FPM:
        return "CLIMB"
    if vertical_rate_fpm <= DESCENT_FPM:
        return "DESCENT"
    return "LEVEL"


def noise_index(slant_m, klass, phase, offset_db=0.0):
    """Estimated outdoor A-weighted LAmax at the station, in dBA.

    Spherical spreading from a 300 m reference plus per-class atmospheric
    absorption. Spreading is exact for a point source at these ranges; the
    absorption term is a single effective coefficient standing in for a
    frequency-resolved calculation, which costs a few dB at the far end.

    Absolute accuracy is roughly +/-5 dB at best and +/-10 dB for pistons on
    generic defaults, so this is rendered as a band and never as a number.
    Returns None when class or phase is unknown, because a ranking built on a
    guessed source level would silently prefer the wrong aircraft.
    """
    if klass is None or phase is None:
        return None
    source = SOURCE_LEVELS[klass][phase] + offset_db
    distance = max(30.0, slant_m)
    divergence = 20.0 * math.log10(distance / 300.0)
    spread = source - divergence

    # Split the source energy, attenuate each band at its own rate, and sum in
    # energy rather than in decibels -- adding dB directly would be wrong by up
    # to 3 dB where the bands are comparable.
    low_fraction = LOW_BAND_FRACTION[klass]
    low = spread + 10.0 * math.log10(low_fraction) - LOW_BAND_DB_PER_M * distance
    high = spread + 10.0 * math.log10(1.0 - low_fraction) - HIGH_BAND_DB_PER_M * distance
    return 10.0 * math.log10(10.0 ** (low / 10.0) + 10.0 ** (high / 10.0))


def nearest_airport(lat, lon):
    best, best_m = None, None
    for field in AIRPORTS:
        east = math.radians(lon - field["lon"]) * EARTH_METERS * math.cos(math.radians(field["lat"]))
        north = math.radians(lat - field["lat"]) * EARTH_METERS
        metres = math.hypot(east, north)
        if best_m is None or metres < best_m:
            best, best_m = field, metres
    return best, best_m


def proximity_band(ground_m, altitude_above_station_ft):
    """Where it passes, on geometry alone. Never needs a category or a phase."""
    if ground_m <= OVERHEAD_GROUND_M and altitude_above_station_ft <= OVERHEAD_CEILING_FT:
        return "OVERHEAD"
    if ground_m <= NEAR_GROUND_M and altitude_above_station_ft <= NEAR_CEILING_FT:
        return "NEAR"
    return "DISTANT"


def bearing_to(from_lat, from_lon, to_lat, to_lon):
    lat1, lat2 = math.radians(from_lat), math.radians(to_lat)
    dlon = math.radians(to_lon - from_lon)
    y = math.sin(dlon) * math.cos(lat2)
    x = math.cos(lat1) * math.sin(lat2) - math.sin(lat1) * math.cos(lat2) * math.cos(dlon)
    return (math.degrees(math.atan2(y, x)) + 360) % 360


def angular_gap(a, b):
    return abs((a - b + 180) % 360 - 180)


def unpredictable(reason, proximity=None, ground_m=None, altitude_ft=None, eta_seconds=None):
    """The third state. Not measured is not the same as not a threat.

    Carries whatever geometry *was* established -- proximity, distance, and the
    time of closest approach -- so an aircraft we cannot score for loudness is
    still reported as overhead, with a countdown, rather than vanishing from the
    advisory. Only the loudness is withheld, because only the loudness is
    unknown.
    """
    return {
        "risk": "UNKNOWN",
        "confidence": "NONE",
        "approaching": proximity == "OVERHEAD",
        "reasons": [reason],
        "eta_seconds": eta_seconds,
        "ground_distance_m": ground_m,
        "slant_distance_m": None,
        "altitude_ft": altitude_ft,
        "noise_index": None,
        "loudness_band": "UNKNOWN",
        "phase": None,
        "proximity": proximity,
        "arrival_at": None,
        "terminated_by": None,
        "model": model_note(),
    }


def model_note():
    """What the panel prints about how a score was produced.

    Built per call, not once at import: it quotes the ambient, and the ambient
    is now live. A note claiming 40 dBA while the model actually used 32 would
    be worse than no note at all, because it is the line a reader trusts to
    explain the number printed beside it.
    """
    return ("constant heading over a 3 min horizon, terminated at the runway; "
            f"estimated outdoor dBA against a {ambient_dba():.0f} dBA ambient, "
            "from published certification and AEDT data; no measured sound; "
            "unvalidated at this site; +/-5-10 dB")


MODEL_NOTE = model_note()


def predict_pass(lat, lon, altitude_ft, category, speed_kt, track_deg, vertical_rate_fpm, seen,
                 hex_code=None):
    """Project the live track and report the closest approach *while airborne*.

    Three things this deliberately refuses to do, each of which the 2026-08-11
    FR24 comparison showed to be wrong:

      1. It never extrapolates a descent below the runway it is aimed at. A
         landing aircraft stops being an airborne noise source at touchdown;
         the old model projected ASA783 to 0 ft over the house and called it
         LIKELY while it was seconds from the PDX threshold, 6.4 km north.
      2. It never ranks by proximity alone. Thrust state moves the received
         level by ~15 dB and is free in vert_rate.
      3. It never guesses a source level for an aircraft of unknown class or
         unknown vertical rate. That returns UNKNOWN, not LOW.
    """
    east, north = local_offsets(lat, lon)

    # A helicopter slowing over a helipad is not unpredictable, it is stationary
    # -- and that is the loudest moment of the whole arrival. Refusing to
    # predict below 20 kt silently dropped exactly the aircraft this station
    # most needs to see.
    stationary = (not isinstance(speed_kt, (int, float)) or speed_kt < 20
                  or not isinstance(track_deg, (int, float)))
    if stationary:
        velocity_east = velocity_north = 0.0
        eta_cpa = 0.0
    else:
        speed = speed_kt * KNOTS_TO_METERS_PER_SECOND
        track = math.radians(track_deg)
        velocity_east = speed * math.sin(track)
        velocity_north = speed * math.cos(track)
        eta_cpa = -(east * velocity_east + north * velocity_north) / (velocity_east**2 + velocity_north**2)

    phase = thrust_phase(vertical_rate_fpm)
    klass = airframe_class(category, hex_code)
    rate = vertical_rate_fpm if isinstance(vertical_rate_fpm, (int, float)) else 0.0

    # Where does this track end? A descent aimed at a nearby field terminates at
    # THAT FIELD's elevation, which may be well below ours -- PDX sits at 31 ft
    # and this station at ~200 ft. Flooring at the station instead would cut the
    # projection short and report an altitude the aircraft never flies.
    field, field_m = nearest_airport(lat, lon)
    arrival_at = None
    floor_ft = STATION_ALT_FT
    terminated_by = None
    eta_limit = PREDICTION_HORIZON_SECONDS

    # Rotorcraft are exempt from arrival termination. Their descents are steep
    # and local, helipads are everywhere, and suppressing an air ambulance
    # because a runway happens to lie within 25 km is the worst false negative
    # this station can produce.
    if rate < 0 and klass != "rotorcraft":
        aligned = (field is not None and not stationary
                   and angular_gap(bearing_to(lat, lon, field["lat"], field["lon"]),
                                   track_deg) <= ARRIVAL_ALIGNMENT_DEG)
        if aligned and field_m <= 25_000 and altitude_ft - field["elevation_ft"] <= 6_000:
            arrival_at = field["id"]
            floor_ft = field["elevation_ft"]
        seconds_to_floor = (altitude_ft - floor_ft) / (-rate) * 60.0
        if 0 <= seconds_to_floor < eta_limit:
            eta_limit = seconds_to_floor
            terminated_by = (f"reaches {arrival_at} field elevation" if arrival_at
                             else "reaches station elevation")

    eta = max(0.0, min(eta_limit, eta_cpa))
    cpa_east = east + velocity_east * eta
    cpa_north = north + velocity_north * eta
    ground_cpa = math.hypot(cpa_east, cpa_north)
    projected_altitude = max(floor_ft, altitude_ft + rate * eta / 60.0)
    altitude_above_station = max(0.0, projected_altitude - STATION_ALT_FT)
    slant_cpa = math.hypot(ground_cpa, altitude_above_station * FEET_TO_METERS)

    # Explicit None test: the index is a relative level and is routinely
    # negative at long range, so truthiness would read a distant aircraft as
    # unscorable.
    proximity = proximity_band(ground_cpa, altitude_above_station)

    index = noise_index(slant_cpa, klass, phase, type_offset_db(hex_code))
    if index is None:
        missing = "emitter category" if klass is None else "vertical rate"
        return unpredictable(
            f"no {missing}; close pass reported on geometry alone" if proximity == "OVERHEAD"
            else f"no {missing}; cannot rank loudness without guessing a source level",
            proximity=proximity, ground_m=round(ground_cpa, 1),
            altitude_ft=round(projected_altitude), eta_seconds=round(eta))

    # A pass only exists if the aircraft is still meaningfully above us when it
    # gets there. ASA783 was projected over the house at 0 ft and called LIKELY
    # while it was landing at PDX, 6.4 km north; height above the station is
    # what distinguishes an overflight from an arrival at somebody else's runway.
    #
    # There is no minimum ETA. Requiring one silenced the advisory at the exact
    # moment an aircraft was overhead, which is when the noise happens and when
    # the panel is most worth reading.
    # The discriminator is *landing somewhere else*, not merely being low. An
    # earlier version suppressed anything projected below 100 ft above the
    # station, which silenced a helicopter descending onto a hospital pad beside
    # the house -- and reported "below the loudness threshold" while the index
    # was 92. A guard that misstates its own blocker is worse than no guard.
    landing_elsewhere = arrival_at is not None and altitude_above_station < 100.0
    receding = eta_cpa < -5.0
    approaching = not receding and not landing_elsewhere and eta < PREDICTION_HORIZON_SECONDS
    _very_loud, loud_at, audible_at = thresholds()
    if approaching and index >= loud_at:
        risk, reasons = "LIKELY", [f"{phase.lower()} thrust at {ground_cpa/1000:.1f} km"]
    elif approaching and index >= audible_at:
        risk, reasons = "POSSIBLE", [f"{phase.lower()} thrust at {ground_cpa/1000:.1f} km"]
    elif receding:
        risk, reasons = "LOW", ["closest approach is already behind it"]
    elif landing_elsewhere:
        risk, reasons = "LOW", [f"descending into {arrival_at}; below station height at closest approach"]
    else:
        risk, reasons = "LOW", [
            f"estimated {index:.0f} dBA at closest approach, under the "
            f"{audible_at:.0f} dBA audible floor for a "
            f"{ambient_dba():.0f} dBA ambient"]

    return {
        "risk": risk,
        "confidence": "HIGH" if seen <= 5 else "MEDIUM",
        "approaching": approaching,
        "reasons": reasons,
        "eta_seconds": round(eta),
        "ground_distance_m": round(ground_cpa, 1),
        "slant_distance_m": round(slant_cpa, 1),
        "altitude_ft": round(projected_altitude),
        "noise_index": round(index, 1),
        "loudness_band": loudness_band(index),
        "phase": phase,
        "proximity": proximity,
        "arrival_at": arrival_at,
        "terminated_by": terminated_by,
        "model": model_note(),
    }


def landmarks():
    """Nearby fields and helipads as bearing + distance from the station.

    Published as RELATIVE geometry, never as coordinates. The panel needs to
    draw Providence west of the house to make the approach corridor legible,
    but the station's position is the home address and must not reach the
    served files as a coordinate pair, let alone git. A bearing and a range
    give the map everything it needs and disclose nothing on their own.
    """
    out = []
    for field in AIRPORTS:
        east = math.radians(field["lon"] - STATION_LON) * EARTH_METERS * math.cos(
            math.radians(STATION_LAT))
        north = math.radians(field["lat"] - STATION_LAT) * EARTH_METERS
        metres = math.hypot(east, north)
        if metres > 25_000:
            continue
        out.append({
            "id": field["id"],
            "bearing": round((math.degrees(math.atan2(east, north)) + 360) % 360, 1),
            "distance_km": round(metres / 1000.0, 2),
        })
    return sorted(out, key=lambda f: f["distance_km"])


def read_source():
    with SOURCE.open() as stream:
        data = json.load(stream)
    if not isinstance(data, dict) or not isinstance(data.get("aircraft"), list):
        raise ValueError("aircraft.json has no aircraft array")
    return data


def heard_unlocated(items):
    """Roster airframes the receiver is hearing but has not managed to locate.

    dump1090 lists an aircraft as soon as it decodes any Mode S message from
    it, but a position needs a matched even/odd pair of CPR-encoded frames. A
    helicopter that transmits briefly, or that is shadowed for part of its
    pass, can be heard for minutes and never be located. `make_report` drops
    those, which is right for the geometry it computes and wrong as a warning:
    on 2026-08-13 the receiver heard AB4825 -- N826LF, a Life Flight
    helicopter -- for over two minutes at -33 dBm while the panel showed
    nothing at all and the aircraft was audible from the ground.

    Reported as its own state. Deliberately no distance, no ETA and no noise
    index: none of them can be computed without a position, and signal
    strength is not a calibrated range -- a strong signal means a good path,
    not a short one. "Heard, not located" is the honest third state, and it is
    the one that matters most here, because the roster is precisely the loud
    traffic this station exists to warn about.

    Restricted to the roster on purpose. Every pass has a dozen unlocated
    addresses, and an advisory that fires on all of them says nothing.
    """
    out = []
    for item in items:
        if isinstance(item.get("lat"), (int, float)) and isinstance(item.get("lon"), (int, float)):
            continue
        hex_code = str(item.get("hex", "")).upper()
        airframe = panel_loud_operators.lookup_hex(hex_code)
        if airframe is None:
            continue
        seen = item.get("seen")
        messages = item.get("messages")
        if not isinstance(seen, (int, float)) or seen > UNLOCATED_SECONDS:
            continue
        if not isinstance(messages, int) or messages < UNLOCATED_MIN_MESSAGES:
            continue
        out.append({
            "hex": hex_code,
            "reg": airframe.get("reg"),
            "operator": airframe.get("operator"),
            "operator_name": panel_loud_operators.operator_name(airframe),
            "operator_kind": panel_loud_operators.operator_kind(airframe),
            "icao_type": airframe.get("type"),
            "callsign": (str(item["flight"]).strip() or None) if isinstance(item.get("flight"), str) else None,
            "rssi_dbm": item.get("rssi") if isinstance(item.get("rssi"), (int, float)) else None,
            "messages": messages,
            "seen_seconds": round(float(seen), 1),
            "alt_ft": item.get("altitude") if isinstance(item.get("altitude"), (int, float)) else None,
            # Named so the panel cannot render this as a quiet aircraft or as a
            # located one. There is no number here to mistake for a distance.
            "state": "HEARD_NO_POSITION",
        })
    out.sort(key=lambda entry: entry["seen_seconds"])
    return out


def make_report(item, source_now):
    lat, lon = item.get("lat"), item.get("lon")
    altitude = item.get("altitude")
    seen = item.get("seen", STALE_SECONDS + 1)
    if not all(isinstance(value, (int, float)) for value in (lat, lon, altitude, seen)):
        return None
    if seen > STALE_SECONDS:
        return None
    distance, bearing = geometry(lat, lon, altitude)
    category = item.get("category")
    hex_code = str(item.get("hex", "")).upper()
    callsign = (str(item["flight"]).strip() or None) if isinstance(item.get("flight"), str) else None
    prediction = predict_pass(
        lat,
        lon,
        altitude,
        category,
        item.get("speed"),
        item.get("track"),
        item.get("vert_rate"),
        seen,
        hex_code=hex_code,
    )
    phase = thrust_phase(item.get("vert_rate"))
    now_index = noise_index(distance, airframe_class(category, hex_code), phase,
                            type_offset_db(hex_code))

    # Identification from the local roster. Costs nothing, needs no network, and
    # works for the aircraft that broadcast no emitter category at all.
    learned = enriched_types().get(panel_loud_operators.normalise_hex(hex_code) or "")
    learned = learned if isinstance(learned, dict) else {}
    operator_state, operator_reason, airframe = panel_loud_operators.identify(
        hex_code=hex_code, callsign=callsign, aircraft_type=None)
    return {
        "hex": hex_code,
        # str(None) is the string "None", which the panel would print as a
        # callsign. Coerce only when there is something to coerce.
        "callsign": callsign,
        # Roster identification. `operator` is None when the airframe is not
        # recognised -- which is NOT the same as "not a known-loud operator",
        # and the panel must render it as unknown rather than as ordinary.
        "operator": (airframe or {}).get("operator"),
        # Display name, so the panel never has to translate an enum key into
        # something a person reads at 3am.
        #
        # Falls back to the registered owner the enricher learned from adsbdb.
        # Until 2026-08-13 this was roster-only -- sixteen hand-curated
        # airframes -- while the learned owner was published under `owner`,
        # which the panel never read for this line. So an aircraft whose
        # operator was sitting in the database, correctly, still displayed
        # "OPERATOR NOT IDENTIFIED": N643QX read as unidentified while the row
        # next to it said Alaska Airlines. 440 of 509 known airframes carry an
        # operator, so the effect was to hide almost everything we know.
        "operator_name": (panel_loud_operators.operator_name(airframe) if airframe
                          else None) or learned.get("operator"),
        # Where that name came from. A hand-verified roster entry carries
        # judgement and provenance; a bulk lookup carries neither, and the two
        # must stay distinguishable rather than being merged into one string.
        "operator_source": ("ROSTER" if airframe else
                            "LOOKUP" if learned.get("operator") else None),
        # From the roster OR the callsign pattern: Life Flight is confirmed
        # by registration pattern with no roster entry, and its kind was lost
        # here until 2026-08-17. Never from learned lookup data.
        "operator_kind": panel_loud_operators.kind_for(hex_code, callsign),
        "operator_state": operator_state,
        "operator_reason": operator_reason,
        # Roster first, then whatever the airframe database supplied. A
        # registration is what a person recognises; a hex is not.
        "registration": (airframe or {}).get("reg") or learned.get("reg"),
        "icao_type": (airframe or {}).get("type") or learned.get("type"),
        "owner": (airframe or {}).get("model") or learned.get("operator"),
        # Where it came from and where it is going. None for most traffic here,
        # which is absence rather than failure: a private aircraft transmits
        # its registration as a callsign and has no route.
        "route": route_for(callsign),
        "category": item.get("category"),
        "squawk": item.get("squawk"),
        "lat": lat,
        "lon": lon,
        "alt_ft": altitude,
        "speed_kt": item.get("speed"),
        "track_deg": item.get("track"),
        "dist": round(distance, 1),
        # Kilometres as well as metres: the pass tracker and the durable log key
        # on distance_km, and deriving it in two places invites them to disagree.
        "distance_km": round(distance / 1000.0, 3),
        "bearing": round(bearing, 1),
        "noise_index": None if now_index is None else round(now_index, 1),
        # Deprecated alias of noise_index, kept only so the un-updated radar
        # canvas on the Pi keeps colouring and labelling. NOT decibels.
        "db": None if now_index is None else round(now_index, 1),
        "phase": phase,
        "airframe_class": airframe_class(category, hex_code),
        "vertical_rate_fpm": item.get("vert_rate"),
        "rssi": item.get("rssi"),
        "last_seen": source_now - seen,
        "prediction": prediction,
    }


def select_candidate(candidates):
    """Pick the advisory subject, and hold it until it resolves.

    Without the hold the subject changed identity every second -- three
    different callsigns inside one minute on 2026-08-11 -- because ranking ran
    fresh over a terminal area that always has several aircraft in it. A warning
    that renames itself faster than it can be read is not a warning.

    Approach state is re-checked here rather than assumed from the caller's
    filtering: this function decides what the panel names, so it enforces its
    own precondition.
    """
    global held
    open_passes = [r for r in candidates if r["prediction"]["approaching"]]
    if held is not None:
        still = next((r for r in open_passes if r["hex"] == held), None)
        if still is not None:
            return still
        held = None
    if not open_passes:
        return None
    held = open_passes[0]["hex"]
    return open_passes[0]


def notable(report):
    """Whether a pass is one the owner probably cared about.

    Recorded on the row as a flag; it never decides whether the row exists.
    Close enough to hear, OR positively identified as an operator reported as
    loud -- the second is independent because an identified air ambulance at
    6 km matters and an anonymous light aircraft at 3 km usually does not.
    """
    if report.get("operator_state") == panel_loud_operators.CONFIRMED:
        return True
    km = report.get("distance_km")
    return isinstance(km, (int, float)) and km <= NOTABLE_KM


def worth_logging(report):
    """Every pass inside the watch radius, so the record has no blind spot."""
    km = report.get("distance_km")
    return isinstance(km, (int, float)) and km <= LOG_WITHIN_KM


def log_finished_passes(reports, now):
    """Record one row per completed pass. Never raises into the publish loop.

    This is the receiver's own record, so unlike the FR24 path it carries a
    loudness estimate when the model could produce one -- and `None` when it
    could not, which is the state that matters most. An unscored aircraft that
    passed overhead is the single most important row this log can hold, and
    writing a number there would make it read as a quiet one.
    """
    global last_prune
    for report in reports:
        passes.observe(report, now)
    for _, report in passes.close_finished(now):
        if not worth_logging(report):
            continue
        prediction = report.get("prediction") or {}
        try:
            panel_noise_log.append(panel_noise_log.build_event(
                at=now,
                # Ours, off an antenna on this roof -- no vendor licence governs
                # it, so these rows never expire.
                provenance=panel_noise_log.ADSB,
                callsign=report.get("callsign"),
                hex_code=report.get("hex"),
                registration=report.get("registration"),
                # ICAO type designator ONLY. The ADS-B emitter category ("A3")
                # is a different vocabulary describing a size class, not a type,
                # and putting one in the other's column makes every later
                # type-based lookup wrong. Absent stays absent.
                aircraft_type=report.get("icao_type"),
                air_ambulance=report.get("operator_state") or "UNCONFIRMED",
                air_ambulance_reason=report.get("operator_reason"),
                distance_km=report.get("distance_km"),
                altitude_ft=report.get("alt_ft"),
                phase=report.get("phase"),
                noise_index=report.get("noise_index"),
                loudness_band=loudness_band(report.get("noise_index")),
                reason=(prediction.get("reasons") or [None])[0],
                notable=notable(report),
                # What the panel showed. Recorded so a pass can be
                # reconstructed later without replaying a live feed -- which is
                # what reviewing a disputed FAINT verdict used to require.
                detail={
                    "bearing_deg": report.get("bearing"),
                    "speed_kt": report.get("speed_kt"),
                    "track_deg": report.get("track_deg"),
                    "vertical_rate_fpm": report.get("vertical_rate_fpm"),
                    "rssi_dbm": report.get("rssi"),
                    "emitter_category": report.get("category"),
                    "airframe_class": report.get("airframe_class"),
                    "operator_source": report.get("operator_source"),
                    "cpa_ground_m": prediction.get("ground_distance_m"),
                    "cpa_slant_m": prediction.get("slant_distance_m"),
                    "cpa_altitude_ft": prediction.get("altitude_ft"),
                    "eta_seconds": prediction.get("eta_seconds"),
                    # Without this a stored score is uninterpretable: the same
                    # column held an invented relative index before
                    # 2026-08-13 and estimated dBA after.
                    "ambient_dba": ambient_dba(),
                },
            ))
        except OSError as exc:
            print(f"panel-adsb-status: cannot append noise log: {exc}", flush=True)

    if now - last_prune >= PRUNE_EVERY_SECONDS:
        last_prune = now
        try:
            removed = panel_noise_log.prune(now=now)
            if removed:
                print(f"panel-adsb-status: pruned {removed} expired log rows", flush=True)
        except OSError as exc:
            print(f"panel-adsb-status: cannot prune noise log: {exc}", flush=True)


def noise_history_doc():
    """The attributor's document, reloaded only when the file changes.

    Missing or unreadable is {} -- no events confirmed yet, or the attributor
    has never run. Nothing is marked in that case; absence of history must
    never invent one, and stale history keeps its own generated_at visible.
    """
    try:
        mtime = ATTRIBUTIONS_JSON.stat().st_mtime
    except OSError:
        return {}
    if _attributions_cache["mtime"] != mtime:
        try:
            with ATTRIBUTIONS_JSON.open() as stream:
                doc = json.load(stream)
            _attributions_cache["doc"] = doc if isinstance(doc, dict) else {}
            _attributions_cache["mtime"] = mtime
        except (OSError, ValueError):
            return _attributions_cache["doc"]
    return _attributions_cache["doc"]


def noise_history_summary(frame):
    """The per-airframe marking the panels render: distinct human and cat
    counts with first/last timestamps. Distinct on purpose -- the cat outcome
    is top priority and must never be collapsed into 'heard'."""
    return {"human_heard_count": frame.get("human_heard_count", 0),
            "cat_scared_count": frame.get("cat_scared_count", 0),
            "first_heard_at": frame.get("first_heard_at"),
            "last_heard_at": frame.get("last_heard_at"),
            "event_ids": frame.get("event_ids") or []}


def attach_noise_history(rows, airframes):
    """Mark every published aircraft that has ever caused a confirmed event.

    Mutates the report rows (adsb_predictions holds the same dicts, so both
    lists carry the mark). An aircraft with no history gets no key at all --
    absent, not false, so older readers ignore it.
    """
    marked = 0
    for row in rows:
        frame = airframes.get(str(row.get("hex") or "").upper())
        if frame:
            row["noise_history"] = noise_history_summary(frame)
            marked += 1
    return marked


def track_rows_from_reports(reports, now, last_logged):
    """Points worth writing this cycle: 1 s cadence near, 5 s out to the
    track radius. Pure given the throttle dict, which it advances."""
    rows = []
    for report in reports:
        km = report.get("distance_km")
        lat, lon = report.get("lat"), report.get("lon")
        if not isinstance(km, (int, float)) or km > TRACK_RADIUS_KM:
            continue
        if not isinstance(lat, (int, float)) or not isinstance(lon, (int, float)):
            continue
        key = ("adsb", report.get("hex") or report.get("callsign"))
        interval = 1.0 if km <= TRACK_NEAR_KM else TRACK_INTERVAL_SECONDS
        last = last_logged.get(key)
        if last is not None and now - last < interval:
            continue
        last_logged[key] = now
        rows.append({
            "at": now, "provenance": "adsb",
            "hex": report.get("hex") or None,
            "callsign": report.get("callsign"),
            "registration": report.get("registration"),
            "lat": lat, "lon": lon,
            "alt_ft": report.get("alt_ft"),
            "speed_kt": report.get("speed_kt"),
            "track_deg": report.get("track_deg"),
            "vertical_rate_fpm": report.get("vertical_rate_fpm"),
            "rssi_dbm": report.get("rssi"),
            "distance_km": km,
            "bearing_deg": report.get("bearing"),
            "retain_until": None,
        })
    return rows


def track_rows_from_fr24(doc, previous_written_at):
    """(rows, written_at). One batch per distinct FR24 cache write; replaying
    the same cache twice must not duplicate points, so the caller passes the
    last written_at it consumed."""
    if not isinstance(doc, dict) or doc.get("feed_state") != "FRESH":
        return [], previous_written_at
    written_at = doc.get("written_at")
    if not isinstance(written_at, (int, float)) or written_at == previous_written_at:
        return [], previous_written_at
    rows = []
    for aircraft in doc.get("aircraft") or []:
        if not isinstance(aircraft, dict):
            continue
        lat, lon = aircraft.get("lat"), aircraft.get("lon")
        km = aircraft.get("distance_km")
        if not isinstance(lat, (int, float)) or not isinstance(lon, (int, float)):
            continue
        if isinstance(km, (int, float)) and km > TRACK_RADIUS_KM:
            continue
        rows.append({
            "at": written_at, "provenance": "fr24",
            "hex": aircraft.get("hex") or None,
            "fr24_id": aircraft.get("fr24_id"),
            "callsign": aircraft.get("callsign"),
            "registration": aircraft.get("reg"),
            "lat": lat, "lon": lon,
            "alt_ft": aircraft.get("alt_ft"),
            "speed_kt": aircraft.get("speed_kt"),
            "track_deg": aircraft.get("track_deg"),
            "vertical_rate_fpm": aircraft.get("vertical_rate_fpm"),
            "distance_km": km if isinstance(km, (int, float)) else None,
            "bearing_deg": aircraft.get("bearing"),
            "retain_until": written_at + panel_noise_log.FR24_RETENTION_SECONDS,
        })
    return rows, written_at


def append_track_points(rows):
    if not rows:
        return
    TRACK_SPOOL.parent.mkdir(parents=True, exist_ok=True)
    with TRACK_SPOOL.open("a") as stream:
        for row in rows:
            stream.write(json.dumps(row, separators=(",", ":"), allow_nan=False))
            stream.write("\n")
        stream.flush()
        os.fsync(stream.fileno())


def log_track_points(reports, now):
    """Never raises into the publish loop; a full disk must not kill the panel."""
    global _fr24_track_written_at
    try:
        rows = track_rows_from_reports(reports, now, _track_last_logged)
        fr24_doc = None
        try:
            with FR24_CACHE_JSON.open() as stream:
                fr24_doc = json.load(stream)
        except (OSError, ValueError):
            fr24_doc = None
        fr24_rows, _fr24_track_written_at = track_rows_from_fr24(
            fr24_doc, _fr24_track_written_at)
        append_track_points(rows + fr24_rows)
    except OSError as exc:
        print(f"panel-adsb-status: cannot append track points: {exc}", flush=True)


def publish():
    global history
    source = read_source()
    source_now = float(source.get("now", time.time()))
    reports = [report for item in source["aircraft"] if (report := make_report(item, source_now))]
    unlocated = heard_unlocated(source["aircraft"])
    now = time.time()
    history.extend(
        {"hex": report["hex"], "noise_index": report["noise_index"], "db": report["db"],
         "phase": report["phase"], "time": now}
        for report in reports if report["noise_index"] is not None
    )
    history = [entry for entry in history if entry["time"] >= now - HISTORY_SECONDS]
    loudest = {}
    for entry in history:
        previous = loudest.get(entry["hex"])
        if previous is None or entry["noise_index"] > previous["noise_index"]:
            loudest[entry["hex"]] = entry
    top = sorted(loudest.values(), key=lambda entry: entry["noise_index"], reverse=True)[:10]

    # Rank by predicted relative loudness at closest airborne approach, not by
    # who arrives first. A narrowbody climbing at takeoff thrust 4 km away beats
    # a light single gliding in at 1 km, and the old ETA ordering had that
    # exactly backwards.
    #
    # An OVERHEAD aircraft is a candidate even when it cannot be scored. Air
    # ambulances frequently arrive with no emitter category, and dropping them
    # for that reason would silence the advisory for the loudest, lowest,
    # closest traffic this station sees.
    # An aircraft we scored and found quiet is not "expected noise", even if it
    # passes overhead -- listing it would bury the ones that matter. An aircraft
    # we could NOT score stays, because absence of a score is not evidence of
    # quiet.
    candidates = [
        report for report in reports
        if report["prediction"]["risk"] in ("LIKELY", "POSSIBLE")
        or (report["prediction"].get("proximity") == "OVERHEAD"
            and report["prediction"]["noise_index"] is None)
    ]
    # Unscored-but-overhead sorts first: it is the one case where the geometry
    # is known to be bad and the loudness cannot be shown not to be. Ranking it
    # below a scored aircraft would hide it behind a number we do have, which is
    # the failure this whole state exists to prevent.
    def rank(report):
        index = report["prediction"]["noise_index"]
        return (1, -index) if index is not None else (0, 0.0)

    candidates.sort(key=rank)

    # Absolute instant rather than a relative countdown. The panel re-renders
    # once a second from whatever status.json it last fetched, so a stored
    # "in 90 s" would freeze at 90 if the feed stalled and keep promising a
    # flyover that already happened. An epoch lets the page count down honestly
    # and reach zero on its own.
    for report in candidates:
        eta = report["prediction"]["eta_seconds"]
        report["prediction"]["at_epoch"] = None if eta is None else now + eta
    unknown = [report for report in reports
               if report["prediction"]["risk"] == "UNKNOWN"
               and report["prediction"].get("proximity") != "OVERHEAD"]

    # Historical noise markings: an airframe confirmed as the cause of a past
    # marked event carries its history on every appearance, loud or quiet.
    history_doc = noise_history_doc()
    marked_airframes = history_doc.get("airframes") or {}
    attach_noise_history(reports, marked_airframes)
    attach_noise_history(unlocated, marked_airframes)

    out = {
        "schema": 3,
        "written_at": now,
        # Presentation preference, read live from settings so the kiosk
        # follows the admin toggle without a restart. Every numeric field in
        # this document stays metric/aviation regardless -- conversion is the
        # DISPLAY's job, exactly once, at render.
        "display_units": ("metric" if panel_settings.flag(
            "display_metric", "PANEL_DISPLAY_METRIC", False) else "imperial"),
        "source_age_s": max(0.0, now - source_now),
        "messages": source.get("messages"),
        "station_alt_ft": STATION_ALT_FT,
        # Relative geometry only -- see landmarks(). Never coordinates.
        "landmarks": landmarks(),
        # Outer extent of the plan view. Matched to the FR24 watch circle rather
        # than to the NEAR band, so the map shows traffic while it is still
        # approaching instead of only once it is already close.
        "watch_radius_km": float(os.environ.get("ADSB_MAP_RADIUS_KM", "12")),
        "adsb_planes": reports,
        "adsb_top": top,
        "adsb_predictions": candidates,
        # Separate from adsb_planes because these have no geometry. Anything
        # that plots, ranges or scores an aircraft must not read this array.
        "adsb_heard_unlocated": unlocated,
        # Present even when empty, so a reader can distinguish "no airframe
        # has ever been marked" from "the attributor has never run".
        "noise_history": {"generated_at": history_doc.get("generated_at"),
                          "marked_airframes": len(marked_airframes)},
        "adsb_advisory": {
            "armed": False,
            "status": "NOT ARMED",
            "model": model_note(),
            "next": select_candidate(candidates),
            # Aircraft we could not score at all. Never counted as quiet.
            "unscored": [
                {"hex": report["hex"], "reason": report["prediction"]["reasons"][0]}
                for report in unknown
            ],
        },
    }
    log_finished_passes(reports, now)
    log_track_points(reports, now)

    OUTPUT.parent.mkdir(parents=True, exist_ok=True)
    with TMP.open("w") as stream:
        json.dump(out, stream, separators=(",", ":"), allow_nan=False)
        stream.write("\n")
        stream.flush()
        os.fsync(stream.fileno())
    os.chmod(TMP, 0o644)
    os.replace(TMP, OUTPUT)


def main():
    while True:
        try:
            publish()
        except (OSError, ValueError, TypeError) as exc:
            print(f"panel-adsb-status: {exc}", flush=True)
        time.sleep(INTERVAL)


if __name__ == "__main__":
    main()

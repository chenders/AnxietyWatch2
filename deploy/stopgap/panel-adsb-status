def geometry(lat, lon, altitude_ft):
    """Slant range and bearing from the station. Pure geometry, no acoustics."""
    lat1, lat2 = math.radians(STATION_LAT), math.radians(lat)
    dlat = lat2 - lat1
    dlon = math.radians(lon - STATION_LON)
    a = math.sin(dlat / 2) ** 2 + math.cos(lat1) * math.cos(lat2) * math.sin(dlon / 2) ** 2
    ground = EARTH_METERS * 2 * math.atan2(math.sqrt(a), math.sqrt(max(0.0, 1 - a)))
    vertical = abs(altitude_ft - STATION_ALT_FT) * FEET_TO_METERS
    distance = math.hypot(ground, vertical)

    y = math.sin(dlon) * math.cos(lat2)
    x = math.cos(lat1) * math.sin(lat2) - math.sin(lat1) * math.cos(lat2) * math.cos(dlon)
    bearing = (math.degrees(math.atan2(y, x)) + 360) % 360
    return distance, bearing


def local_offsets(lat, lon):
    """Metres east and north of the station."""
    east = math.radians(lon - STATION_LON) * EARTH_METERS * math.cos(math.radians(STATION_LAT))
    north = math.radians(lat - STATION_LAT) * EARTH_METERS
    return east, north


# Exact ICAO types learned from the public airframe database, written by
# panel-aircraft-enrich. Read from a FILE, never from PostgreSQL: this loop
# rewrites the bedside panel once a second and must not block on a database.
AIRCRAFT_CACHE = Path(os.environ.get(
    "PANEL_AIRCRAFT_CACHE", "/var/lib/panel-noise/aircraft_types.json"))
_cache = {}
_cache_mtime = None


def enriched_types():
    """hex -> {reg, type, operator}, reloaded only when the file changes.

    A missing or unreadable cache is not an error: it means no enrichment has
    run yet, and every aircraft simply falls through to whatever it broadcasts.
    """
    global _cache, _cache_mtime
    try:
        mtime = AIRCRAFT_CACHE.stat().st_mtime
    except OSError:
        return _cache
    if mtime != _cache_mtime:
        try:
            with AIRCRAFT_CACHE.open() as stream:
                loaded = json.load(stream)
            entries = loaded.get("aircraft")
            if isinstance(entries, dict):
                _cache = entries
                _cache_mtime = mtime
        except (OSError, ValueError):
            pass
    return _cache



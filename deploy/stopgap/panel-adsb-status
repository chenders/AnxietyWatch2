# Atmospheric absorption, as two bands summed in energy.
#
# A single coefficient cannot work across a 40x distance range, and trying it
# produced an obvious absurdity on the first live run: a heavy descending 9.3 km
# out scored 17.7 dBA, twenty-two decibels BELOW ambient, i.e. silent. Airliners
# at 9 km are plainly audible.
#
# The cause is that absorption is strongly frequency-dependent. High frequencies
# are absorbed far faster than low ones, so a receding aircraft's spectrum
# shifts downward and the surviving low-frequency energy then attenuates slowly.
# Any fixed rate is therefore either too low near the source or far too high in
# the far field, and 4 dB/km compounds to 37 dB over 9.3 km.
#
# Two bands reproduce that shift for a few lines of arithmetic: ~500 Hz at
# 1 dB/km and ~2-4 kHz at 10 dB/km, recombined as energy. The high band is gone
# by a few kilometres, which is exactly the real behaviour.
LOW_BAND_DB_PER_M = 0.001
HIGH_BAND_DB_PER_M = 0.010

# Fraction of A-weighted source energy in the low band. Rotor noise is
# low-frequency dominated -- blade slap is felt as much as heard, and carries a
# long way. Jets carry proportionally more high-frequency energy, which is why
# they fade with distance faster than a helicopter of the same source level.
LOW_BAND_FRACTION = {
    "heavy": 0.50,
    "jet": 0.50,
    "turboprop": 0.65,
    "light": 0.65,
    "rotorcraft": 0.80,
}

# Outdoor ambient assumed for this location: low-density suburban, ~40 dBA.
# Every threshold below is derived from it, so a quieter or noisier site is one
# constant away rather than four. Report it alongside any score.
# Read live, not once at import. The admin console changes this to recalibrate
# every band at once, and a publisher that had to be restarted to notice would
# drop the warning state mid-pass -- which has already cost a real alert.
#
# 25-70 dBA is the range from a quiet rural night to a busy urban street.
# Outside it the value is refused and the previous one kept: an ambient of 0
# would call every aircraft VERY LOUD, and one of 200 would silence the system
# entirely. Either is a plausible typo and neither should be obeyed.
def ambient_dba():
    return panel_settings.number("ambient_dba", "ADSB_AMBIENT_DBA", 40.0,
                                 minimum=25.0, maximum=70.0)


AMBIENT_DBA = ambient_dba()

# Bands as levels above ambient, not absolute constants.
#
# The old thresholds (88/78/68) put the audible floor 28 dB above ambient,
# which is why a Cessna 172 passing 0.89 km away scored 63 and was labelled
# FAINT. Detectability practice treats an aircraft as audible at roughly 3-4 dB
# above ambient; FAR Part 36 requires 3 dB per third-octave for a measurement
# to count at all. +5 is a conservative floor that allows for masking.
#
# LOUD begins at ambient+15, the region where a single event interferes with
# speech and where sleep-disturbance onset sits: WHO puts the indoor no-effect
# maximum at 42 dBA and asks that events above 45 dBA indoors be limited, which
# through an open window (~15 dB) is about 57-60 dBA outdoors.
# Offsets from ambient, not absolute constants. The module-level values below
# are the boot-time snapshot; anything deciding a band at runtime must call
# thresholds() so a live ambient change takes effect on the next frame.
VERY_LOUD_OVER_AMBIENT = 30.0   # dominant single events
LIKELY_OVER_AMBIENT = 15.0      # intrusive; speech interference, sleep onset
POSSIBLE_OVER_AMBIENT = 5.0     # reliably detectable above masking


def thresholds():
    """(very loud, loud, audible) in dBA, against the current ambient."""
    ambient = ambient_dba()
    return (ambient + VERY_LOUD_OVER_AMBIENT,
            ambient + LIKELY_OVER_AMBIENT,
            ambient + POSSIBLE_OVER_AMBIENT)


VERY_LOUD_INDEX = AMBIENT_DBA + VERY_LOUD_OVER_AMBIENT   # 70 dBA at 40 ambient
LIKELY_INDEX = AMBIENT_DBA + LIKELY_OVER_AMBIENT         # 55 dBA
POSSIBLE_INDEX = AMBIENT_DBA + POSSIBLE_OVER_AMBIENT     # 45 dBA


def loudness_band(index):
    """The word the panel prints. Never a decibel figure.

    There is no microphone yet, so nothing here knows how loud anything is
    indoors. These are ranked estimates of relative received level outdoors and
    the panel labels them as unvalidated on every frame.
    """
    if index is None:
        return "UNKNOWN"
    very_loud, loud, audible = thresholds()
    if index >= very_loud:
        return "VERY LOUD"
    if index >= loud:
        return "LOUD"
    if index >= audible:
        return "AUDIBLE"
    return "FAINT"



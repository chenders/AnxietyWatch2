# ---------------------------------------------------------------------------
# Noise events, corroborations, candidates, attribution verdicts, and track
# points. Same rules as the pass drain: the JSONL is the write-ahead record,
# every insert is idempotent, and a bad row is skipped with its reason counted
# rather than blocking the spool behind it forever.
# ---------------------------------------------------------------------------

def outcomes_of(row):
    """(human_heard, cat_scared). A double press has always meant BOTH."""
    outcomes = row.get("outcomes")
    if isinstance(outcomes, list) and outcomes:
        return "human_heard" in outcomes, "cat_scared_top_priority" in outcomes
    if row.get("press_count", 0) >= 2 or row.get("label") == "cat_scared_top_priority":
        return True, True
    return True, False


def hex_of(identity):
    if isinstance(identity, str):
        text = identity.strip().upper()
        if len(text) == 6 and all(c in HEX_RE_CHARS for c in text):
            return text
    return None


def normalise_label(row):
    """One label spool row -> ('event'|'corroboration'|'synthetic'|None, payload).

    Synthetic is refused HERE, by provenance, before the database ever sees
    it -- and the schema CHECK refuses it again if this filter regresses.
    """
    if not isinstance(row, dict):
        return None, None
    provenance = row.get("provenance")
    if provenance == "synthetic":
        return "synthetic", None
    if provenance not in REAL_PROVENANCES:
        return None, None
    observed = row.get("observed_at")
    event_id = row.get("event_id")
    if not isinstance(observed, (int, float)) or not isinstance(event_id, str) or not event_id:
        return None, None
    if row.get("corroborates"):
        report = row.get("operator_report") or {}
        return "corroboration", {
            "event_id": str(row["corroborates"]),
            "reported_at": observed,
            "source": report.get("source"),
            "note": report.get("note") or row.get("meaning"),
        }
    if row.get("eligible_for_training") is not True:
        return None, None
    human, cat = outcomes_of(row)
    report = row.get("operator_report") or {}
    return "event", {
        "event_id": event_id,
        "observed_at": observed,
        "recorded_at": row.get("recorded_at") if isinstance(row.get("recorded_at"), (int, float)) else None,
        "human_heard": human,
        "cat_scared": cat,
        "press_count": integer(row.get("press_count")),
        "provenance": provenance,
        # A hold (warning_unheard) drains with BOTH outcome booleans false;
        # the note carries why, so a (false, false) row is never mistaken for
        # a row that lost its outcomes. The full label rides in evidence.
        "note": report.get("note") or (
            "warning_unheard: a light warning fired but nothing was heard"
            if "warning_unheard" in (row.get("outcomes") or []) else None),
        "evidence": row,
        "weather": row.get("weather") if isinstance(row.get("weather"), dict) else None,
    }


def candidate_db_row(event_id, observed_at, candidate):
    """One attributor candidate -> one noise_event_candidate row, or None.

    retain_until applies only to candidates known EXCLUSIVELY through FR24:
    anything the local receiver also saw is our own data and keeps forever.
    """
    if not isinstance(candidate, dict) or not isinstance(candidate.get("identity"), str):
        return None
    feeds = [f for f in candidate.get("feeds") or [] if isinstance(f, str)]
    raw = candidate.get("raw") if isinstance(candidate.get("raw"), dict) else {}
    prediction = raw.get("prediction") if isinstance(raw.get("prediction"), dict) else {}
    distance = number(prediction.get("ground_distance_m"))
    if distance is not None:
        distance /= 1000.0
    if distance is None:
        metres = number(raw.get("dist"))
        distance = metres / 1000.0 if metres is not None else number(raw.get("distance_km"))
    noise = number(prediction.get("noise_index"))
    if noise is None:
        noise = number(raw.get("noise_index"))
    phase = prediction.get("phase") or raw.get("phase")
    klass = candidate.get("airframe_class")
    fr24_only = bool(feeds) and all(f == "fr24" for f in feeds)
    return {
        "event_id": event_id,
        "identity": candidate["identity"],
        "icao_hex": hex_of(candidate["identity"]) or hex_of(raw.get("hex")),
        "callsign": candidate.get("callsign"),
        "registration": candidate.get("registration"),
        "icao_type": candidate.get("aircraft_type"),
        "airframe_class": klass if klass in AIRFRAME_CLASSES else None,
        "fr24_id": raw.get("fr24_id"),
        "feeds": feeds or ["unknown"],
        "score": number(candidate.get("score")),
        "reasons": candidate.get("reasons") or [],
        "distance_km": distance if distance is None or distance >= 0 else None,
        "altitude_ft": integer(prediction.get("altitude_ft")) or integer(raw.get("alt_ft")),
        "noise_index": noise,
        "phase": phase if phase in PHASES else None,
        "raw": raw,
        "retain_until": (observed_at + FR24_RETENTION_SECONDS) if fr24_only else None,
    }


def attribution_db_row(event, generated_at):
    if not isinstance(event, dict) or not isinstance(event.get("event_id"), str):
        return None
    verdict = event.get("verdict")
    if verdict not in ("CONFIRMED", "AMBIGUOUS", "UNATTRIBUTED"):
        return None
    confirmed = event.get("confirmed_candidate") or {}
    return {
        "event_id": event["event_id"],
        "generated_at": generated_at,
        "verdict": verdict,
        "verdict_reason": str(event.get("verdict_reason") or "unstated"),
        "margin": number(event.get("margin")),
        "candidate_count": integer(event.get("candidate_count")),
        "confirmed_hex": hex_of(confirmed.get("identity")),
        "confirmed_identity": confirmed.get("identity"),
        "confirmed_registration": confirmed.get("registration"),
        "confirmed_type": confirmed.get("aircraft_type"),
        "flight_key": event.get("flight_key"),
        "method": str(event.get("method") or "unstated"),
    }


def attribution_signature(row):
    """What must change for a new history row to be worth writing. Re-runs
    that reach the same verdict are cron noise, not decisions."""
    return (row["verdict"], row["confirmed_identity"], row["margin"],
            row["verdict_reason"], row["method"])


def normalise_track(row):
    if not isinstance(row, dict):
        return None
    at = number(row.get("at"))
    lat, lon = number(row.get("lat")), number(row.get("lon"))
    provenance = row.get("provenance")
    if (at is None or lat is None or lon is None or provenance not in ("adsb", "fr24")
            or not -90 <= lat <= 90 or not -180 <= lon <= 180):
        return None
    retain = number(row.get("retain_until"))
    if provenance == "fr24" and retain is None:
        return None            # undeletable vendor data is not admitted
    if provenance == "adsb":
        retain = None
    distance = number(row.get("distance_km"))
    return {
        "at": at, "provenance": provenance,
        "icao_hex": hex_of(row.get("hex")),
        "fr24_id": row.get("fr24_id"),
        "callsign": row.get("callsign"),
        "registration": row.get("registration"),
        "lat": lat, "lon": lon,
        "alt_ft": integer(row.get("alt_ft")),
        "speed_kt": integer(row.get("speed_kt")),
        "track_deg": number(row.get("track_deg")),
        "vertical_rate_fpm": integer(row.get("vertical_rate_fpm")),
        "rssi_dbm": number(row.get("rssi_dbm")),
        "distance_km": distance if distance is None or distance >= 0 else None,
        "bearing_deg": number(row.get("bearing_deg")),
        "retain_until": retain,
    }



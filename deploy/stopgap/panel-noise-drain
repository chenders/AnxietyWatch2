        %(callsign)s, %(registration)s, %(lat)s, %(lon)s, %(alt_ft)s,
        %(speed_kt)s, %(track_deg)s, %(vertical_rate_fpm)s, %(rssi_dbm)s,
        %(distance_km)s, %(bearing_deg)s, to_timestamp(%(retain_until)s))
ON CONFLICT DO NOTHING
"""

TRACK_SPOOL = Path(os.environ.get("PANEL_TRACK_LOG", "/var/lib/panel-noise/track-points.jsonl"))
# When the fully-drained track spool exceeds this, it is rotated to one kept
# generation. The database is the archive; the file is the write-ahead record,
# and an unbounded 1 Hz position log would eventually fill the card that also
# holds the clinical panel.
TRACK_ROTATE_BYTES = int(os.environ.get("PANEL_TRACK_ROTATE_BYTES", str(64 * 1024 * 1024)))


def pending_range(path, key):
    """(offset, size) with the shrink guard, or None when nothing is pending."""
    try:
        size = path.stat().st_size
    except OSError:
        return None
    offset = read_offset(key)
    if offset > size:
        print(f"panel-noise-drain: {path.name} shrank ({size} < {offset}); replaying from 0",
              flush=True)
        offset = 0
    if offset == size:
        return None
    return offset, size


def parse_pending(path, offset, parser):
    """(parsed rows, skipped count, end offset)."""
    rows, skipped = [], 0
    with path.open() as stream:
        stream.seek(offset)
        for line in stream:
            line = line.strip()
            if not line:
                continue
            try:
                parsed = parser(json.loads(line))
            except ValueError:
                parsed = None
            if parsed is None:
                skipped += 1
                continue
            rows.append(parsed)
        end = stream.tell()
    return rows, skipped, end


def drain_warnings(cur):
    pending = pending_range(WARNINGS, "warnings_offset_bytes")
    if pending is None:
        return None
    offset, _ = pending
    rows, skipped, end = parse_pending(WARNINGS, offset, normalise_warning)
    stored = 0
    for row in rows:
        row = dict(row,
                   prediction=(psycopg2.extras.Json(row["prediction"])
                               if row["prediction"] is not None else None),
                   matched_pass=(psycopg2.extras.Json(row["matched_pass"])
                                 if row["matched_pass"] is not None else None),
                   raw=psycopg2.extras.Json(row["raw"]))
        cur.execute(INSERT_WARNING, row)
        stored += cur.rowcount
    return {"key": "warnings_offset_bytes", "end": end, "drained": stored,
            "skipped": skipped, "name": "warnings"}


def drain_warning_reviews(cur):
    pending = pending_range(WARNING_REVIEWS, "warning_reviews_offset_bytes")
    if pending is None:
        return None
    offset, _ = pending
    rows, skipped, end = parse_pending(WARNING_REVIEWS, offset,
                                       normalise_warning_review)
    stored = 0
    for row in rows:
        cur.execute(INSERT_WARNING_REVIEW, row)
        stored += cur.rowcount
    return {"key": "warning_reviews_offset_bytes", "end": end,
            "drained": stored, "skipped": skipped,
            "name": "warning reviews"}


def expire_unreviewed_warnings(cur):
    """Close stale review opportunities without deleting warning evidence."""
    cur.execute(EXPIRE_UNREVIEWED_WARNINGS,
                (WARNING_REVIEW_WINDOW_SECONDS, WARNING_REVIEW_WINDOW_SECONDS))
    return {"drained": cur.rowcount, "skipped": 0,
            "name": "expired warning reviews"}


def drain_passes(cur):
    pending = pending_range(SPOOL, "offset_bytes")
    if pending is None:
        return None
    offset, _ = pending
    rows, skipped, end = parse_pending(SPOOL, offset, normalise)
    for row in rows:
        # Bound by name; see the INSERT comment above.
        cur.execute(INSERT, row)
        hex_code = row["icao_hex"]
        if hex_code:
            # Provenance is the row's own, not a constant: a hardcoded 'fr24'
            # labelled receiver-learned identities as vendor data.
            cur.execute(UPSERT_AIRCRAFT,
                        (hex_code, row["registration"], row["icao_type"],
                         row["provenance"], row["at"], row["at"]))
    return {"key": "offset_bytes", "end": end, "drained": len(rows), "skipped": skipped,
            "name": "passes"}


def drain_labels(cur):
    pending = pending_range(LABELS, "labels_offset_bytes")
    if pending is None:
        return None
    offset, _ = pending
    rows, skipped, end = parse_pending(LABELS, offset, normalise_label)
    events = corroborations = synthetic = deferred = 0
    for kind, payload in rows:
        if kind == "event":
            payload = dict(payload,
                           evidence=psycopg2.extras.Json(payload["evidence"]),
                           weather=(psycopg2.extras.Json(payload["weather"])
                                    if payload["weather"] is not None else None))
            cur.execute(INSERT_EVENT, payload)
            events += 1
        elif kind == "corroboration":
            cur.execute(INSERT_CORROBORATION, payload)
            if cur.rowcount == 0:
                # Named, not silent: either already stored, or its event has
                # not drained yet and the next run re-presents it.
                print(f"panel-noise-drain: corroboration for {payload['event_id']} "
                      f"not stored this run (duplicate or event not yet drained)",
                      flush=True)
                deferred += 1
            else:
                corroborations += 1
        elif kind == "synthetic":
            synthetic += 1
    return {"key": "labels_offset_bytes", "end": end, "drained": events,
            "skipped": skipped, "name": "events",
            "detail": f"{corroborations} corroborations, {synthetic} synthetic refused, "
                      f"{deferred} deferred"}


def sync_attributions(cur):
    """Verdict history and full candidate sets, from the attributor's document.

    Appends a history row only when the verdict CONTENT changed, so re-runs
    read as decisions rather than cron noise. Candidates are inserted for
    every event each time; (event_id, identity) conflicts make that free.
    """
    try:
        with ATTRIBUTIONS.open() as stream:
            doc = json.load(stream)
    except (OSError, ValueError):
        return None
    if not isinstance(doc, dict):
        return None
    generated_at = doc.get("generated_at")
    if not isinstance(generated_at, (int, float)):
        return None
    if read_state().get("attributions_generated_at") == generated_at:
        return None
    verdicts = candidates = 0
    for event in doc.get("events") or []:
        row = attribution_db_row(event, generated_at)
        if row is None:
            continue
        cur.execute(LATEST_ATTRIBUTION, (row["event_id"],))
        latest = cur.fetchone()
        if latest is None or tuple(latest) != attribution_signature(row):
            cur.execute(INSERT_ATTRIBUTION, row)
            verdicts += cur.rowcount
        observed_at = event.get("observed_at")
        if not isinstance(observed_at, (int, float)):
            continue
        for candidate in event.get("candidates") or []:
            db_row = candidate_db_row(event["event_id"], observed_at, candidate)
            if db_row is None:
                continue
            db_row["reasons"] = psycopg2.extras.Json(db_row["reasons"])
            db_row["raw"] = psycopg2.extras.Json(db_row["raw"])
            cur.execute(INSERT_CANDIDATE, db_row)
            candidates += cur.rowcount
    return {"state": {"attributions_generated_at": generated_at},
            "drained": verdicts, "name": "verdict changes",
            "detail": f"{candidates} new candidate rows"}


def drain_track(cur):
    pending = pending_range(TRACK_SPOOL, "track_offset_bytes")
    if pending is None:
        return None
    offset, _ = pending
    rows, skipped, end = parse_pending(TRACK_SPOOL, offset, normalise_track)
    if rows:
        psycopg2.extras.execute_batch(cur, INSERT_TRACK, rows, page_size=500)
    return {"key": "track_offset_bytes", "end": end, "drained": len(rows),
            "skipped": skipped, "name": "track points"}


def rotate_track_spool():
    """Bound the fully-drained track spool. One generation is kept beside the
    live file; the database holds everything. Runs only when the offset has
    reached the end, so nothing undrained is ever rotated away."""
    try:
        size = TRACK_SPOOL.stat().st_size
    except OSError:
        return
    if size <= TRACK_ROTATE_BYTES or read_offset("track_offset_bytes") != size:
        return
    kept = TRACK_SPOOL.with_name(TRACK_SPOOL.name + ".1")
    os.replace(TRACK_SPOOL, kept)
    write_offset(0, "track_offset_bytes")
    print(f"panel-noise-drain: rotated track spool ({size} bytes) to {kept.name}", flush=True)


def disk_note():
    try:
        import shutil
        usage = shutil.disk_usage(str(STATE.parent))
        return f"{usage.free / 1e9:.1f} GB free"
    except OSError:
        return "disk free unknown"


def drain():
    if psycopg2 is None:
        print("panel-noise-drain: psycopg2 is not installed", file=sys.stderr)
        return 1

    results = []
    with psycopg2.connect(DSN) as conn:
        with conn.cursor() as cur:
            # Labels first so events exist before their attribution verdicts
            # and candidate sets arrive; both are WHERE EXISTS-guarded anyway.
            for step in (drain_labels, sync_attributions, drain_warnings,
                         drain_warning_reviews, expire_unreviewed_warnings,
                         drain_passes, drain_track):
                result = step(cur)
                if result:
                    results.append(result)
    # Offsets and markers advance only after the one transaction above
    # commits, so a failure replays rather than silently dropping a batch.
    for result in results:
        if "key" in result:
            write_offset(result["end"], result["key"])
    markers = {}
    for result in results:
        markers.update(result.get("state") or {})
    if markers:
        state = read_state()
        state.update(markers)
        STATE.parent.mkdir(parents=True, exist_ok=True)
        tmp = STATE.with_name(f".{STATE.name}.tmp")
        with tmp.open("w") as stream:
            json.dump(state, stream)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(tmp, STATE)
    rotate_track_spool()
    if results:
        summary = "; ".join(
            f"{r['drained']} {r['name']}"
            + (f" ({r['detail']})" if r.get("detail") else "")
            + (f", {r['skipped']} skipped" if r.get("skipped") else "")
            for r in results)
        print(f"panel-noise-drain: {summary}; {disk_note()}", flush=True)
    return 0


if __name__ == "__main__":
    raise SystemExit(drain())

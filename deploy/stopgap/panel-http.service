# Stopgap: serve the panel and its status file to the local browser only.
# 127.0.0.1 deliberately — this is health data and it does not leave the box.
[Unit]
Description=AnxietyWatch bedside panel — local HTTP (stopgap)
# local-fs.target because the served directory is a checkout under /home now,
# and a unit whose WorkingDirectory does not exist yet fails rather than waits.
After=network.target local-fs.target

[Service]
Type=simple
User=chris
# Served straight out of a git checkout, so `git pull` IS the deploy step.
# Previously this was a copy under /var/lib, which meant every panel change
# needed an scp and silently went stale the moment one was forgotten.
WorkingDirectory=/opt/anxietywatch-panel/docs/design/pi-panel/direction-a-clinical
ExecStart=/usr/bin/python3 -m http.server 8975 --bind 127.0.0.1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

#!/usr/bin/env python3
"""Inject explicitly synthetic aircraft-label evidence for plumbing tests.

This bypasses Hue transport by design but uses the same durable JSONL schema.
It has no mode capable of producing real or training-eligible evidence.
"""
import argparse
import fcntl
import json
import os
import time
import uuid
from pathlib import Path

LABELS = Path(os.environ.get("PANEL_AIRCRAFT_LABELS", "/var/lib/panel-noise/aircraft-labels.jsonl"))


def build(presses, observed_at, note):
    label = "cat_scared_top_priority" if presses == 2 else "human_heard"
    return {"schema": 1, "event_id": f"synthetic-{uuid.uuid4()}",
            "observed_at": observed_at, "recorded_at": time.time(),
            "press_count": presses, "label": label, "priority": presses,
            "provenance": "synthetic", "eligible_for_training": False,
            "meaning": "operator-injected plumbing test; not an observation",
            "synthetic": {"tool": "panel-aircraft-inject", "note": note}}


def append(path, row):
    path.parent.mkdir(parents=True, exist_ok=True)
    lock_path = path.with_name(f".{path.name}.lock")
    with lock_path.open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        with path.open("a") as stream:
            stream.write(json.dumps(row, sort_keys=True, separators=(",", ":")) + "\n")
            stream.flush()
            os.fsync(stream.fileno())


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--presses", type=int, choices=(1, 2), required=True)
    parser.add_argument("--note", required=True, help="why synthetic evidence is being injected")
    parser.add_argument("--at", type=float, default=None)
    parser.add_argument("--output", type=Path, default=LABELS)
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args(argv)
    row = build(args.presses, time.time() if args.at is None else args.at, args.note)
    if not args.dry_run:
        append(args.output, row)
    print(json.dumps(row, indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

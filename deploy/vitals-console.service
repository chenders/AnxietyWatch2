[Unit]
Description=Vitals read and administration console
After=network.target vitalsd.service postgresql.service
Requires=vitalsd.service postgresql.service

[Service]
Type=simple
ExecStart=/usr/local/bin/vitals-console
Restart=always
RestartSec=3
User=vitals
Group=vitals

# Amendment 10: the first draft serves the owner-controlled private LAN over
# HTTP. Bind to the Pi's configured private address, never to all interfaces.
Environment=VITALS_CONSOLE_BIND=192.168.1.48:8480
Environment=VITALS_CONSOLE_PRIVATE_LAN=1
Environment=VITALS_CONSOLE_TLS_TERMINATED=0
Environment=VITALS_CONSOLE_TRUST_PROXY=0
# Set the LAN host and Argon2id verifier in this root-only file.
Environment=VITALS_CONSOLE_ADMIN_HOST=192.168.1.48:8480
EnvironmentFile=-/etc/vitals/vitals-console.env
Environment=VITALSD_SOCKET=/run/vitals/vitalsd.sock
Environment=DATABASE_URL=host=/var/run/postgresql user=vitals dbname=vitals
# systemd consumes one percent sign; the process receives `%2F` URL escapes.
Environment=VITALS_CONSOLE_DATABASE_URL=postgres://vitals@%%2Fvar%%2Frun%%2Fpostgresql/vitals
Environment=VITALS_CONSOLE_ASSETS=/usr/local/share/vitals-console/assets

# This is an observability surface, not the safety path. Prefer collectors,
# vitalsd, and klaxond under memory pressure.
OOMScoreAdjust=200

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target

# Select the known USB controller without binding to a physical USB port or hciN alias.
# The broker fails closed if more than one controller matches this identity.
VITALS_BLE_ADAPTER_SELECTOR=bus=usb;vid_pid=0a12:0001
VITALS_BLE_BROKER_SOCKET=/run/vitals/ble-broker.sock
VITALS_BLE_BROKER_METRICS_PATH=/run/vitals/ble-broker.prom

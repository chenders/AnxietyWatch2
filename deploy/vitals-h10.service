[Unit]
Description=Polar H10 heart-rate and RR collector
After=bluetooth.service vitalsd.service vitals-ble-broker.service
Requires=bluetooth.service vitalsd.service vitals-ble-broker.service

[Service]
Type=simple
ExecStart=/usr/local/bin/h10-collector
Restart=always
RestartSec=3
EnvironmentFile=/etc/vitals/h10-collector.env
Environment=VITALSD_SOCKET=/run/vitals/vitalsd.sock
Environment=VITALS_BLE_BROKER_SOCKET=/run/vitals/ble-broker.sock
# VITALS_BLE_ADAPTER_SELECTOR must be supplied by the deployment inventory;
# never use hci0/hci1 here.
Environment=H10_STATE_DIR=/var/lib/vitals/h10
# Stopgap panel transport: current status is atomic; history is append-only.
# Values retain registry-canonical units and declare them in each document.
Environment=H10_LIVE_STATUS_JSON=/run/vitals-h10/status.json
Environment=H10_LIVE_HISTORY_JSONL=/run/vitals-h10/history.jsonl
User=vitals
Group=vitals
# StateDirectory, not ReadWritePaths: a ReadWritePaths target that does not
# exist yet fails namespace setup, so first boot becomes a Restart=always
# 226/NAMESPACE loop that never runs the code that would create it.
StateDirectory=vitals/h10
RuntimeDirectory=vitals-h10
RuntimeDirectoryMode=0755
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target

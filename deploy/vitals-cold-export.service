[Unit]
Description=Monthly immutable vitals cold export
After=postgresql@16-main.service

[Service]
Type=oneshot
User=postgres
Group=postgres
Nice=15
IOSchedulingClass=best-effort
IOSchedulingPriority=7
CPUWeight=10
IOWeight=10
OOMScoreAdjust=800
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/usr/local/share/vitals
ReadWritePaths=/var/lib/vitals/cold
ExecStart=/usr/local/bin/vitals-cold-export.sh
